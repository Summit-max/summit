<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand palette -->
    <Color x:Key="OrangeHot">#FF6A00</Color>
    <Color x:Key="OrangeMid">#FF4D00</Color>
    <Color x:Key="RedOrange">#FF3B1F</Color>
    <Color x:Key="RedDeep">#D7261E</Color>

    <!-- Backgrounds -->
    <Color x:Key="BgDark">#0E0E10</Color>
    <Color x:Key="BgMid">#17171A</Color>
    <Color x:Key="BgCard">#1E1E23</Color>
    <Color x:Key="BgCardHover">#272730</Color>
    <Color x:Key="BgSidebar">#111114</Color>
    <Color x:Key="BgInput">#2A2A32</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F5F5F5</Color>
    <Color x:Key="TextSecondary">#9999AA</Color>
    <Color x:Key="TextMuted">#55555F</Color>

    <!-- UI accents -->
    <Color x:Key="BorderSubtle">#2A2A35</Color>
    <Color x:Key="BorderAccent">#FF6A00</Color>
    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="Warning">#FACC15</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="Info">#38BDF8</Color>

    <!-- Rank colors -->
    <Color x:Key="RankGold">#FFD700</Color>
    <Color x:Key="RankSilver">#C0C0C0</Color>
    <Color x:Key="RankBronze">#CD7F32</Color>

</ResourceDictionary>
