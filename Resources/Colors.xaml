<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ SUMMIT brand palette ═══
         Tema: fogo Summit — degradê laranja→vermelho sobre dark azulado premium. -->
    <Color x:Key="AccentGold">#FF6A00</Color>
    <Color x:Key="AccentAmber">#FF6A00</Color>
    <Color x:Key="AccentEmber">#FF3B1F</Color>
    <Color x:Key="AccentDeep">#D7261E</Color>

    <!-- Backgrounds (cool charcoal) -->
    <Color x:Key="BgDark">#0A0C10</Color>
    <Color x:Key="BgMid">#12151B</Color>
    <Color x:Key="BgCard">#171B22</Color>
    <Color x:Key="BgCardHover">#1E232E</Color>
    <Color x:Key="BgSidebar">#0C0E13</Color>
    <Color x:Key="BgInput">#1C2028</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F2F5FA</Color>
    <Color x:Key="TextSecondary">#9AA5B5</Color>
    <Color x:Key="TextMuted">#5A6577</Color>

    <!-- UI accents -->
    <Color x:Key="BorderSubtle">#262C39</Color>
    <Color x:Key="BorderAccent">#FF6A00</Color>
    <Color x:Key="Success">#2EDE8D</Color>
    <Color x:Key="Warning">#FACC15</Color>
    <Color x:Key="ErrorColor">#F4485E</Color>
    <Color x:Key="Info">#38BDF8</Color>
    <Color x:Key="Live">#22D3EE</Color>

    <!-- Rank colors -->
    <Color x:Key="RankGold">#FFD700</Color>
    <Color x:Key="RankSilver">#C0C0C0</Color>
    <Color x:Key="RankBronze">#CD7F32</Color>

</ResourceDictionary>
