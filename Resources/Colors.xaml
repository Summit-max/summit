<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ SUMMIT brand palette ═══
         Tema: fogo Summit — degradê laranja→vermelho sobre preto neutro premium. -->
    <Color x:Key="AccentGold">#FF6A1A</Color>
    <Color x:Key="AccentAmber">#FF6A1A</Color>
    <Color x:Key="AccentEmber">#FF3B30</Color>
    <Color x:Key="AccentDeep">#FF3B30</Color>

    <!-- Backgrounds (preto neutro, sem tom azulado) -->
    <Color x:Key="BgDark">#0A0A0A</Color>
    <Color x:Key="BgMid">#131313</Color>
    <Color x:Key="BgCard">#181818</Color>
    <Color x:Key="BgCardHover">#212121</Color>
    <Color x:Key="BgSidebar">#0D0D0D</Color>
    <Color x:Key="BgInput">#1E1E1E</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F2F5FA</Color>
    <Color x:Key="TextSecondary">#A5A5A5</Color>
    <Color x:Key="TextMuted">#666666</Color>

    <!-- UI accents -->
    <Color x:Key="BorderSubtle">#2A2A2A</Color>
    <Color x:Key="BorderAccent">#FF6A1A</Color>
    <Color x:Key="Success">#2EDE8D</Color>
    <Color x:Key="Warning">#FACC15</Color>
    <Color x:Key="ErrorColor">#F4485E</Color>
    <Color x:Key="Info">#38BDF8</Color>
    <Color x:Key="Live">#22D3EE</Color>

    <!-- Rank colors -->
    <Color x:Key="RankGold">#FFD700</Color>
    <Color x:Key="RankSilver">#C0C0C0</Color>
    <Color x:Key="RankBronze">#CD7F32</Color>

</ResourceDictionary>
