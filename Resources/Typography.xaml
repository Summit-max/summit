<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="FontPrimary">Segoe UI</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="FontMono">Consolas</FontFamily>

    <sys:Double x:Key="FontSizeXS">10</sys:Double>
    <sys:Double x:Key="FontSizeSM">12</sys:Double>
    <sys:Double x:Key="FontSizeMD">14</sys:Double>
    <sys:Double x:Key="FontSizeLG">16</sys:Double>
    <sys:Double x:Key="FontSizeXL">20</sys:Double>
    <sys:Double x:Key="FontSize2XL">24</sys:Double>
    <sys:Double x:Key="FontSize3XL">32</sys:Double>
    <sys:Double x:Key="FontSize4XL">40</sys:Double>
    <sys:Double x:Key="FontSize5XL">56</sys:Double>

</ResourceDictionary>
