<UserControl x:Class="Summit.Views.TournamentDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Match card visual style -->
        <Style x:Key="MatchCard" TargetType="Border">
            <Setter Property="Background" Value="#13161D"/>
            <Setter Property="BorderBrush" Value="#232937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Match row inner content template (DataContext = BracketMatch) -->
        <DataTemplate x:Key="MatchInnerTpl">
            <Grid Background="Transparent" Cursor="Hand">
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Grid.InputBindings>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>

                <!-- Team A row -->
                <Grid Grid.Row="0" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- winner stripe -->
                    <Rectangle Grid.Column="0" Width="3" Height="16" Margin="0,0,10,0"
                               VerticalAlignment="Center">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AWon}" Value="True">
                                        <Setter Property="Fill" Value="#FF6A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <TextBlock Grid.Column="1" Text="{Binding TeamATag}"
                               FontFamily="Segoe UI" FontSize="13"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#9AA5B5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AWon}" Value="True">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#F2F5FA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="2" Text="{Binding ScoreAText}"
                               FontFamily="Segoe UI" FontSize="14"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#5A6577"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AWon}" Value="True">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#FF6A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Rectangle Grid.Row="1" Fill="#1E1E26" Margin="12,0"/>

                <!-- Team B row -->
                <Grid Grid.Row="2" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Width="3" Height="16" Margin="0,0,10,0"
                               VerticalAlignment="Center">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BWon}" Value="True">
                                        <Setter Property="Fill" Value="#FF6A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <TextBlock Grid.Column="1" Text="{Binding TeamBTag}"
                               FontFamily="Segoe UI" FontSize="13"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#9AA5B5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BWon}" Value="True">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#F2F5FA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="2" Text="{Binding ScoreBText}"
                               FontFamily="Segoe UI" FontSize="14"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#5A6577"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BWon}" Value="True">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#FF6A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Status row -->
                <Border Grid.Row="3" Background="#0B0D12" CornerRadius="0,0,6,6">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TimeLabel}"
                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="9"
                                   Foreground="#5A6577" VerticalAlignment="Center"/>

                        <!-- Live pill -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,5,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.25" Duration="0:0:0.7"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="AO VIVO" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="9" Foreground="#EF4444"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="FINALIZADO" FontFamily="Segoe UI"
                                   FontWeight="Black" FontSize="9" Foreground="#22C55E"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Coluna de rodada genérica: cabeçalho + slots posicionados por Top (espaçamento
             padrão de bracket, dobra a cada rodada) — substitui as posições fixas de antes,
             funciona pra qualquer número de times/rodadas. -->
        <DataTemplate x:Key="BracketColumnTpl">
            <StackPanel Margin="0,0,40,0" Width="240">
                <TextBlock Text="{Binding Header}" FontFamily="Segoe UI" FontWeight="Black"
                           FontSize="10" Foreground="#5A6577" Margin="0,0,0,14"/>
                <ItemsControl ItemsSource="{Binding Slots}" Width="240" Height="{Binding Height}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            <Setter Property="Canvas.Left" Value="0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240" Height="80" Style="{StaticResource MatchCard}">
                                <ContentControl Content="{Binding Match}" ContentTemplate="{StaticResource MatchInnerTpl}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,24,40,40" DataContext="{Binding Tournament}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BACK LINK -->
            <Button Grid.Row="0" HorizontalAlignment="Left" Padding="0" Background="Transparent"
                    BorderThickness="0" Cursor="Hand"
                    Command="{Binding DataContext.BackCommand,
                        RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="#9AA5B5"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="CAMPEONATOS" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="10" Foreground="#9AA5B5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HERO -->
            <Border Grid.Row="2" CornerRadius="14" Padding="0" ClipToBounds="True"
                    BorderBrush="#232937" BorderThickness="1" Height="220">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1A0906" Offset="0"/>
                        <GradientStop Color="#12151B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Ellipse Width="680" Height="680" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Margin="0,0,-240,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#40FF5024" Offset="0"/>
                                <GradientStop Color="#00FF5024" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Path IsHitTestVisible="False" Opacity="0.08"
                          Data="M 0,220 L 120,0 L 180,0 L 60,220 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6A1A" Offset="0"/>
                                <GradientStop Color="#FF3B30" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <Grid Margin="36,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border CornerRadius="3" Padding="8,3" Background="#162D17"
                                        BorderBrush="#4422C55E" BorderThickness="1">
                                    <TextBlock Text="{Binding StatusLabel}" FontFamily="Segoe UI"
                                               FontWeight="Black" FontSize="9" Foreground="#22C55E"/>
                                </Border>
                                <Border CornerRadius="3" Padding="8,3" Background="#141821"
                                        BorderBrush="#262C39" BorderThickness="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CountdownLabel}" FontFamily="Segoe UI"
                                               FontWeight="Black" FontSize="9" Foreground="#FF6A1A"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="38" Foreground="{StaticResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Format}" FontFamily="Segoe UI"
                                       FontSize="13" Foreground="#9AA5B5" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="PRIZE POOL" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="9" Foreground="#5A6577" HorizontalAlignment="Right"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Prize}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="44" HorizontalAlignment="Right" Margin="0,-8,0,0">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF9A3C" Offset="0"/>
                                        <GradientStop Color="#FF3B30" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding DataContext.RegisterCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Right" Height="40" Padding="24,0"
                                    Margin="0,12,0,0">
                                <TextBlock Text="INSCREVER TIME" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="12" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding DataContext.OpenLineupCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Background="Transparent" BorderThickness="1" BorderBrush="#262C39"
                                    HorizontalAlignment="Right" Height="36" Padding="20,0"
                                    Margin="0,8,0,0" Cursor="Hand"
                                    Visibility="{Binding CanEditLineup, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="ESCALAÇÃO" FontFamily="Segoe UI"
                                           FontWeight="Bold" FontSize="11" Foreground="#9AA5B5"/>
                            </Button>
                            <Button Command="{Binding DataContext.CheckInCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Background="#1B7A45" BorderThickness="0"
                                    HorizontalAlignment="Right" Height="36" Padding="20,0"
                                    Margin="0,8,0,0" Cursor="Hand"
                                    Visibility="{Binding CanCheckIn, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="CONFIRMAR CHECK-IN" FontFamily="Segoe UI"
                                           FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding DataContext.EditTournamentCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Background="Transparent" BorderThickness="1" BorderBrush="#262C39"
                                    HorizontalAlignment="Right" Height="36" Padding="20,0"
                                    Margin="0,8,0,0" Cursor="Hand"
                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="#9AA5B5"/>
                                    <TextBlock Text="EDITAR" FontFamily="Segoe UI"
                                               FontWeight="Bold" FontSize="11" Foreground="#9AA5B5"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- DEV: ferramentas de teste local (fora do Hero, que tem ClipToBounds e altura fixa) -->
            <Border Grid.Row="3" CornerRadius="6" Padding="10" Margin="0,10,0,10"
                    Background="#0F1116" BorderBrush="#3A2A1E" BorderThickness="1"
                    HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="DEV — SIMULAÇÃO LOCAL" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="9" Foreground="#FF9A3C" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Command="{Binding DataContext.AddGhostTeamsCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="1" BorderBrush="#262C39"
                            Padding="16,7" Cursor="Hand" Margin="0,0,6,0">
                        <TextBlock Text="+4 TIMES FANTASMA" FontFamily="Segoe UI"
                                   FontWeight="Bold" FontSize="10" Foreground="#9AA5B5"/>
                    </Button>
                    <Button Command="{Binding DataContext.SkipToNowCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="1" BorderBrush="#262C39"
                            Padding="16,7" Cursor="Hand" Margin="0,0,6,0">
                        <TextBlock Text="ABRIR CHECK-IN (~20MIN)" FontFamily="Segoe UI"
                                   FontWeight="Bold" FontSize="10" Foreground="#9AA5B5"/>
                    </Button>
                    <Button Command="{Binding DataContext.AdvanceStageCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="1" BorderBrush="#262C39"
                            Padding="16,7" Cursor="Hand">
                        <TextBlock Text="FECHAR CHECK-IN E GERAR CHAVE" FontFamily="Segoe UI"
                                   FontWeight="Bold" FontSize="10" Foreground="#9AA5B5"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- STATS STRIP -->
            <Border Grid.Row="4" CornerRadius="10" Background="#12151B"
                    BorderBrush="#1E232E" BorderThickness="1">
                <Grid Height="92">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="TIMES" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="9" Foreground="#5A6577" HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TeamsCountText}" FontFamily="Segoe UI"
                                   FontWeight="Black" FontSize="22"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Fill="#1E232E"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="INÍCIO" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="9" Foreground="#5A6577" HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM}}"
                                   FontFamily="Segoe UI" FontWeight="Black" FontSize="22"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Fill="#1E232E"/>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="ORGANIZADOR" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="9" Foreground="#5A6577" HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Organizer}" FontFamily="Segoe UI"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Grid.Column="5" Fill="#1E232E"/>

                    <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="MAP POOL" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="9" Foreground="#5A6577" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding MapPoolText}" FontFamily="Segoe UI"
                                   FontWeight="Bold" FontSize="13" Foreground="#FF6A1A"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SECTION TITLE: CHAVEAMENTO -->
            <StackPanel Grid.Row="6" Orientation="Horizontal">
                <Border Width="3" Height="18" CornerRadius="2" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6A1A" Offset="0"/>
                            <GradientStop Color="#FF3B30" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="CHAVEAMENTO" FontFamily="Segoe UI" FontWeight="Black"
                           FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- BRACKET -->
            <Border Grid.Row="7" Margin="0,14,0,0"
                    CornerRadius="10" Background="#0F1218"
                    BorderBrush="#1E232E" BorderThickness="1" Padding="24">
                <StackPanel>
                    <!-- Chave superior (única chave em eliminação simples) -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DataContext.UpperColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ItemTemplate="{StaticResource BracketColumnTpl}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Chave inferior (só em eliminação dupla) -->
                    <StackPanel Margin="0,28,0,0"
                                Visibility="{Binding DataContext.HasLowerBracket, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CHAVE INFERIOR" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="11" Foreground="#FF6A1A" Margin="0,0,0,14"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding DataContext.LowerColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ItemTemplate="{StaticResource BracketColumnTpl}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Grande final (só em eliminação dupla) -->
                    <StackPanel Margin="0,28,0,0"
                                Visibility="{Binding DataContext.HasLowerBracket, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding DataContext.GrandFinalColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ItemTemplate="{StaticResource BracketColumnTpl}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION TITLE: TIMES INSCRITOS -->
            <StackPanel Grid.Row="9" Orientation="Horizontal">
                <Border Width="3" Height="18" CornerRadius="2" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6A1A" Offset="0"/>
                            <GradientStop Color="#FF3B30" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="TIMES INSCRITOS" FontFamily="Segoe UI" FontWeight="Black"
                           FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TeamsCountText}" FontFamily="Segoe UI" FontWeight="Bold"
                           FontSize="11" Foreground="#5A6577" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>

            <!-- TEAMS GRID -->
            <ItemsControl Grid.Row="10" ItemsSource="{Binding Teams}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,12,12" Padding="16,14" CornerRadius="8"
                                Background="#12151B" BorderBrush="#1E232E" BorderThickness="1"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#70FF6A1A"/>
                                            <Setter Property="Background" Value="#171B22"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <c:LevelBadge Grid.Column="0"
                                              Level="{Binding AverageLevel}"
                                              Size="58"
                                              ShowTier="False"
                                              Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Tag}" FontFamily="Segoe UI"
                                                   FontWeight="Black" FontSize="13"
                                                   Foreground="#FF6A1A"/>
                                        <Rectangle Width="1" Height="10" Fill="#2E3543" Margin="8,0"/>
                                        <TextBlock Text="{Binding SeedLabel}" FontFamily="Segoe UI"
                                                   FontWeight="Bold" FontSize="11"
                                                   Foreground="#5A6577" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#434D5F" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
</UserControl>
