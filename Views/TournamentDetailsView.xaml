<UserControl x:Class="Summit.Views.TournamentDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Match card visual style -->
        <Style x:Key="MatchCard" TargetType="Border">
            <Setter Property="Background" Value="#141419"/>
            <Setter Property="BorderBrush" Value="#24242E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Match row inner content template (DataContext = BracketMatch) -->
        <DataTemplate x:Key="MatchInnerTpl">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>

                <!-- Team A row -->
                <Grid Grid.Row="0" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- winner stripe -->
                    <Rectangle Grid.Column="0" Width="3" Height="16" Margin="0,0,10,0"
                               VerticalAlignment="Center">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AWon}" Value="True">
                                        <Setter Property="Fill" Value="#FF6A00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <TextBlock Grid.Column="1" Text="{Binding TeamATag}"
                               FontFamily="Segoe UI" FontSize="13"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#9999AA"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AWon}" Value="True">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#F5F5F5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="2" Text="{Binding ScoreAText}"
                               FontFamily="Segoe UI" FontSize="14"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#55555F"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AWon}" Value="True">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#FF6A00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Rectangle Grid.Row="1" Fill="#1E1E26" Margin="12,0"/>

                <!-- Team B row -->
                <Grid Grid.Row="2" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Width="3" Height="16" Margin="0,0,10,0"
                               VerticalAlignment="Center">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BWon}" Value="True">
                                        <Setter Property="Fill" Value="#FF6A00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <TextBlock Grid.Column="1" Text="{Binding TeamBTag}"
                               FontFamily="Segoe UI" FontSize="13"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#9999AA"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BWon}" Value="True">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#F5F5F5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="2" Text="{Binding ScoreBText}"
                               FontFamily="Segoe UI" FontSize="14"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#55555F"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BWon}" Value="True">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#FF6A00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Status row -->
                <Border Grid.Row="3" Background="#0C0C11" CornerRadius="0,0,6,6">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TimeLabel}"
                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="9"
                                   Foreground="#55555F" VerticalAlignment="Center"/>

                        <!-- Live pill -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,5,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.25" Duration="0:0:0.7"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="AO VIVO" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="9" Foreground="#EF4444"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="FINALIZADO" FontFamily="Segoe UI"
                                   FontWeight="Black" FontSize="9" Foreground="#22C55E"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,24,40,40" DataContext="{Binding Tournament}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BACK LINK -->
            <Button Grid.Row="0" HorizontalAlignment="Left" Padding="0" Background="Transparent"
                    BorderThickness="0" Cursor="Hand"
                    Command="{Binding DataContext.BackCommand,
                        RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="#9999AA"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="CAMPEONATOS" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="10" Foreground="#9999AA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HERO -->
            <Border Grid.Row="2" CornerRadius="14" Padding="0" ClipToBounds="True"
                    BorderBrush="#24242E" BorderThickness="1" Height="220">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1A0906" Offset="0"/>
                        <GradientStop Color="#17171A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Ellipse Width="680" Height="680" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Margin="0,0,-240,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#40FF4D00" Offset="0"/>
                                <GradientStop Color="#00FF4D00" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Path IsHitTestVisible="False" Opacity="0.08"
                          Data="M 0,220 L 120,0 L 180,0 L 60,220 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6A00" Offset="0"/>
                                <GradientStop Color="#D7261E" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <Grid Margin="36,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border CornerRadius="3" Padding="8,3" Background="#162D17"
                                        BorderBrush="#22C55E44" BorderThickness="1">
                                    <TextBlock Text="{Binding StatusLabel}" FontFamily="Segoe UI"
                                               FontWeight="Black" FontSize="9" Foreground="#22C55E"/>
                                </Border>
                                <Border CornerRadius="3" Padding="8,3" Background="#1A1A22"
                                        BorderBrush="#2A2A35" BorderThickness="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CountdownLabel}" FontFamily="Segoe UI"
                                               FontWeight="Black" FontSize="9" Foreground="#FF6A00"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="38" Foreground="{StaticResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Format}" FontFamily="Segoe UI"
                                       FontSize="13" Foreground="#9999AA" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="PRIZE POOL" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="9" Foreground="#55555F" HorizontalAlignment="Right"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Prize}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="44" HorizontalAlignment="Right" Margin="0,-8,0,0">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF9A3C" Offset="0"/>
                                        <GradientStop Color="#D7261E" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding DataContext.RegisterCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Right" Height="40" Padding="24,0"
                                    Margin="0,12,0,0">
                                <TextBlock Text="INSCREVER TIME" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="12" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- STATS STRIP -->
            <Border Grid.Row="4" CornerRadius="10" Background="#13131A"
                    BorderBrush="#22222A" BorderThickness="1">
                <Grid Height="92">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="TIMES" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="9" Foreground="#55555F" HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TeamsCountText}" FontFamily="Segoe UI"
                                   FontWeight="Black" FontSize="22"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Fill="#22222A"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="INÍCIO" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="9" Foreground="#55555F" HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM}}"
                                   FontFamily="Segoe UI" FontWeight="Black" FontSize="22"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Fill="#22222A"/>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="ORGANIZADOR" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="9" Foreground="#55555F" HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Organizer}" FontFamily="Segoe UI"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Grid.Column="5" Fill="#22222A"/>

                    <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="MAP POOL" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="9" Foreground="#55555F" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding MapPoolText}" FontFamily="Segoe UI"
                                   FontWeight="Bold" FontSize="13" Foreground="#FF6A00"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SECTION TITLE: CHAVEAMENTO -->
            <StackPanel Grid.Row="6" Orientation="Horizontal">
                <Border Width="3" Height="18" CornerRadius="2" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6A00" Offset="0"/>
                            <GradientStop Color="#D7261E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="CHAVEAMENTO" FontFamily="Segoe UI" FontWeight="Black"
                           FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- BRACKET -->
            <Border Grid.Row="7" Margin="0,14,0,0"
                    CornerRadius="10" Background="#101015"
                    BorderBrush="#22222A" BorderThickness="1" Padding="24">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Width="840">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QUARTAS"  FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#55555F"/>
                            <TextBlock Grid.Column="2" Text="SEMIFINAIS" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#55555F"/>
                            <TextBlock Grid.Column="4" Text="FINAL"    FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#55555F"/>
                        </Grid>

                        <Canvas Grid.Row="2" Width="840" Height="384">

                            <Path Stroke="#2A2A35" StrokeThickness="1"
                                  Data="M 240,40 L 260,40 L 260,136 L 240,136 M 260,88 L 280,88
                                        M 240,232 L 260,232 L 260,328 L 240,328 M 260,280 L 280,280
                                        M 520,88 L 540,88 L 540,280 L 520,280 M 540,184 L 560,184"/>

                            <Border Canvas.Left="0"   Canvas.Top="0"   Width="240" Height="80"
                                    Style="{StaticResource MatchCard}">
                                <ContentControl Content="{Binding Bracket[0].Matches[0]}"
                                                ContentTemplate="{StaticResource MatchInnerTpl}"/>
                            </Border>
                            <Border Canvas.Left="0"   Canvas.Top="96"  Width="240" Height="80"
                                    Style="{StaticResource MatchCard}">
                                <ContentControl Content="{Binding Bracket[0].Matches[1]}"
                                                ContentTemplate="{StaticResource MatchInnerTpl}"/>
                            </Border>
                            <Border Canvas.Left="0"   Canvas.Top="192" Width="240" Height="80"
                                    Style="{StaticResource MatchCard}">
                                <ContentControl Content="{Binding Bracket[0].Matches[2]}"
                                                ContentTemplate="{StaticResource MatchInnerTpl}"/>
                            </Border>
                            <Border Canvas.Left="0"   Canvas.Top="288" Width="240" Height="80"
                                    Style="{StaticResource MatchCard}">
                                <ContentControl Content="{Binding Bracket[0].Matches[3]}"
                                                ContentTemplate="{StaticResource MatchInnerTpl}"/>
                            </Border>

                            <Border Canvas.Left="280" Canvas.Top="48"  Width="240" Height="80"
                                    Style="{StaticResource MatchCard}">
                                <ContentControl Content="{Binding Bracket[1].Matches[0]}"
                                                ContentTemplate="{StaticResource MatchInnerTpl}"/>
                            </Border>
                            <Border Canvas.Left="280" Canvas.Top="240" Width="240" Height="80"
                                    Style="{StaticResource MatchCard}">
                                <ContentControl Content="{Binding Bracket[1].Matches[1]}"
                                                ContentTemplate="{StaticResource MatchInnerTpl}"/>
                            </Border>

                            <Border Canvas.Left="560" Canvas.Top="144" Width="240" Height="80"
                                    Style="{StaticResource MatchCard}"
                                    BorderThickness="1.5">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFD700" Offset="0"/>
                                        <GradientStop Color="#FF6A00" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ContentControl Content="{Binding Bracket[2].Matches[0]}"
                                                ContentTemplate="{StaticResource MatchInnerTpl}"/>
                            </Border>

                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- SECTION TITLE: TIMES INSCRITOS -->
            <StackPanel Grid.Row="9" Orientation="Horizontal">
                <Border Width="3" Height="18" CornerRadius="2" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6A00" Offset="0"/>
                            <GradientStop Color="#D7261E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="TIMES INSCRITOS" FontFamily="Segoe UI" FontWeight="Black"
                           FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TeamsCountText}" FontFamily="Segoe UI" FontWeight="Bold"
                           FontSize="11" Foreground="#55555F" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>

            <!-- TEAMS GRID -->
            <ItemsControl Grid.Row="10" ItemsSource="{Binding Teams}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,12,12" Padding="16,14" CornerRadius="8"
                                Background="#13131A" BorderBrush="#22222A" BorderThickness="1"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF6A0070"/>
                                            <Setter Property="Background" Value="#17171F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <c:LevelBadge Grid.Column="0"
                                              Level="{Binding AverageLevel}"
                                              Size="58"
                                              ShowTier="False"
                                              Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Tag}" FontFamily="Segoe UI"
                                                   FontWeight="Black" FontSize="13"
                                                   Foreground="#FF6A00"/>
                                        <Rectangle Width="1" Height="10" Fill="#33333A" Margin="8,0"/>
                                        <TextBlock Text="{Binding SeedLabel}" FontFamily="Segoe UI"
                                                   FontWeight="Bold" FontSize="11"
                                                   Foreground="#55555F" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#44444E" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
</UserControl>
