<UserControl x:Class="Summit.Views.PlayerProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer>
        <Grid Margin="40,24,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Back -->
            <Button Grid.Row="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Command="{Binding BackCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#9AA5B5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="VOLTAR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="10" Foreground="#9AA5B5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HEADER -->
            <Border Grid.Row="2" CornerRadius="12" Padding="28,22" ClipToBounds="True"
                    BorderBrush="#232937" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1A0906" Offset="0"/>
                        <GradientStop Color="#141821" Offset="0.4"/>
                        <GradientStop Color="#141821" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Grid Grid.Column="0" Width="84" Height="84" Margin="0,0,22,0">
                        <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding User.AvatarUrl}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border CornerRadius="42"
                                Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVisibility}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6A1A" Offset="0"/>
                                    <GradientStop Color="#FF3B30" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding InitialLetter}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Ellipse Stroke="#FF6A1A" StrokeThickness="2" Opacity="0.6" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding User.Country}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding User.Nickname}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="28" Foreground="{StaticResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#9AA5B5" Margin="0,4,0,10">
                            <Run Text="Steam ID: "/><Run Text="{Binding User.SteamId, Mode=OneWay}" FontFamily="Consolas" Foreground="#5A6577"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="4" Padding="10,4" Background="#1E232E"
                                    BorderBrush="#262C39" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding User.PrimaryRole}" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                            </Border>
                            <Border CornerRadius="4" Padding="10,4" Background="#1E232E"
                                    BorderBrush="#262C39" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding User.Rank}" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#FF6A1A" FontWeight="Bold"/>
                            </Border>
                            <Border CornerRadius="4" Padding="10,4" Background="#1E232E"
                                    BorderBrush="#262C39" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TeamLabel}" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#9AA5B5"/>
                            </Border>
                            <Border CornerRadius="4" Padding="10,4" Background="#1E232E"
                                    BorderBrush="#262C39" BorderThickness="1"
                                    Visibility="{Binding HasMutualFriends, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding MutualFriendsLabel}" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#9AA5B5"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- LevelBadge + action -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <c:LevelBadge Level="{Binding User.Level}" Size="76" ShowTier="True"
                                      HorizontalAlignment="Right" Margin="0,0,0,14"/>

                        <Button Command="{Binding AddFriendCommand}" Cursor="Hand" BorderThickness="0"
                                Height="34" Padding="18,0"
                                Visibility="{Binding CanAddFriend, Converter={StaticResource BoolToVisibility}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" CornerRadius="5" Background="{StaticResource BrushGradientBrand}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="ADICIONAR AMIGO" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="11" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Border CornerRadius="5" Padding="14,8" Background="#162D17"
                                BorderBrush="#4422C55E" BorderThickness="1"
                                Visibility="{Binding IsAlreadyFriend, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="AMIGOS" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="11" Foreground="#22C55E"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="5" Padding="14,8" Background="#1E232E"
                                BorderBrush="#262C39" BorderThickness="1"
                                Visibility="{Binding HasOutgoing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="PEDIDO PENDENTE" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="11" Foreground="#FACC15"/>
                        </Border>

                        <Border CornerRadius="5" Padding="14,8" Background="#1E232E"
                                BorderBrush="#60FF6A1A" BorderThickness="1"
                                Visibility="{Binding HasIncoming, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="PEDIU PRA TE ADICIONAR" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="10" Foreground="#FF6A1A"/>
                        </Border>

                        <Border CornerRadius="5" Padding="14,8" Background="#1F1416"
                                BorderBrush="#60EF4444" BorderThickness="1" Margin="0,8,0,0"
                                Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BLOQUEADO" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="10" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Command="{Binding UnblockCommand}" Background="Transparent"
                                        BorderThickness="0" Padding="0" Cursor="Hand">
                                    <TextBlock Text="DESBLOQUEAR" FontFamily="Segoe UI" FontWeight="Bold"
                                               FontSize="10" Foreground="#9AA5B5" TextDecorations="Underline"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding BlockCommand}" Background="Transparent"
                                BorderThickness="0" Padding="0" Cursor="Hand" HorizontalAlignment="Right"
                                Margin="0,8,0,0"
                                Visibility="{Binding CanBlock, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="BLOQUEAR USUÁRIO" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="10" Foreground="#5A6577" TextDecorations="Underline"/>
                        </Button>

                        <TextBlock Text="{Binding ActionMessage}" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#9AA5B5" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATS ROW -->
            <Border Grid.Row="4" CornerRadius="10" Background="#12151B"
                    BorderBrush="#1E232E" BorderThickness="1">
                <UniformGrid Columns="6" Height="86">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="K/D" FontFamily="Segoe UI" FontWeight="Black" FontSize="9" Foreground="#5A6577" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding User.KD, StringFormat=F2}" FontFamily="Segoe UI" FontWeight="Black" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="WINRATE" FontFamily="Segoe UI" FontWeight="Black" FontSize="9" Foreground="#5A6577" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding User.WinRate, StringFormat=P0}" FontFamily="Segoe UI" FontWeight="Black" FontSize="20" Foreground="#22C55E" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="HS%" FontFamily="Segoe UI" FontWeight="Black" FontSize="9" Foreground="#5A6577" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding User.HeadshotPercent, StringFormat=P0}" FontFamily="Segoe UI" FontWeight="Black" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="PARTIDAS" FontFamily="Segoe UI" FontWeight="Black" FontSize="9" Foreground="#5A6577" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding User.TotalMatches}" FontFamily="Segoe UI" FontWeight="Black" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="ELO" FontFamily="Segoe UI" FontWeight="Black" FontSize="9" Foreground="#5A6577" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding User.Elo}" FontFamily="Segoe UI" FontWeight="Black" FontSize="20" Foreground="#FF6A1A" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="MAPA FAV" FontFamily="Segoe UI" FontWeight="Black" FontSize="9" Foreground="#5A6577" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding User.FavoriteMap}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#FF6A1A" HorizontalAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Bio -->
            <Border Grid.Row="6" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="BIO" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#FF6A1A" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding User.Bio}" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#9AA5B5" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
