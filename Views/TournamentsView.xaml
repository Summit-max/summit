<UserControl x:Class="Summit.Views.TournamentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:vm="clr-namespace:Summit.ViewModels"
             Background="Transparent" Opacity="0">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <UserControl.Resources>
        <h:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
        <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="40,32,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="TORNEIOS" FontFamily="Segoe UI" FontWeight="Black"
                   FontSize="36" Foreground="{StaticResource BrushTextPrimary}"/>
        <TextBlock Grid.Row="2" Text="Encontre um campeonato, inscreva seu time e compita."
                   FontFamily="Segoe UI" FontSize="13" Foreground="#9999AA"/>

        <!-- Filter pills -->
        <ItemsControl Grid.Row="4" ItemsSource="{Binding Filters}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FilterItem}">
                    <Button Command="{Binding DataContext.FilterCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Name}"
                            Margin="0,0,8,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" CornerRadius="20" Padding="16,7"
                                        SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#13131A"/>
                                            <Setter Property="BorderBrush" Value="#22222A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                               FontWeight="Bold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9999AA"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF6A00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Root" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#25FF6A00" Offset="0"/>
                                                    <GradientStop Color="#15D7261E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#FF6A0080"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#FF6A0060"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Tournament cards -->
        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Filtered}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="380" Margin="0,0,20,20" CornerRadius="12"
                                Background="#13131A" ClipToBounds="True"
                                Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#22222A"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.45" Direction="270"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF6A0080"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.015" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.015" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.0" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- BANNER -->
                                <Grid Grid.Row="0" ClipToBounds="True">
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2A0F06" Offset="0"/>
                                                <GradientStop Color="#3A1208" Offset="0.4"/>
                                                <GradientStop Color="#1A0804" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Line X1="0" Y1="140" X2="400" Y2="0"
                                          Stroke="#20FF6A00" StrokeThickness="80"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          IsHitTestVisible="False"/>

                                    <Ellipse Width="360" Height="360" HorizontalAlignment="Right"
                                             VerticalAlignment="Center" Margin="0,0,-120,0"
                                             IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#50FF6A00" Offset="0"/>
                                                <GradientStop Color="#00FF6A00" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="130" Foreground="#18FFFFFF"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,12,0" IsHitTestVisible="False"/>

                                    <Rectangle VerticalAlignment="Bottom" Height="40">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0013131A" Offset="0"/>
                                                <GradientStop Color="#13131A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <!-- Status pill -->
                                    <Border CornerRadius="4" Padding="10,5"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="16,16,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#15361F"/>
                                                <Setter Property="BorderBrush" Value="#22C55E60"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                        <Setter Property="Background" Value="#3A2A0A"/>
                                                        <Setter Property="BorderBrush" Value="#FACC1560"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                                        <Setter Property="Background" Value="#14233A"/>
                                                        <Setter Property="BorderBrush" Value="#38BDF860"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                        <Setter Property="Background" Value="#1A1A22"/>
                                                        <Setter Property="BorderBrush" Value="#44444E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,7,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#22C55E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                <Setter Property="Fill" Value="#FACC15"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                                                <Setter Property="Fill" Value="#38BDF8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                                <Setter Property="Fill" Value="#55555F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusLabel}" FontFamily="Segoe UI"
                                                       FontWeight="Black" FontSize="9">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                <Setter Property="Foreground" Value="#FACC15"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                                <Setter Property="Foreground" Value="#9999AA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Game tag -->
                                    <Border CornerRadius="4" Padding="8,4"
                                            Background="#0D0D11" BorderBrush="#2A2A35" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,16,16,0">
                                        <TextBlock Text="{Binding Game}" FontFamily="Segoe UI"
                                                   FontWeight="Bold" FontSize="10" Foreground="#CCCCD4"/>
                                    </Border>

                                    <!-- Countdown badge -->
                                    <Border CornerRadius="14" Padding="12,5"
                                            Background="#CC0D0D11" BorderBrush="#FF6A0060"
                                            BorderThickness="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="16,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Foreground="#FF6A00"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding CountdownLabel}" FontFamily="Segoe UI"
                                                       FontWeight="Black" FontSize="10"
                                                       Foreground="#F5F5F5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- BODY -->
                                <StackPanel Grid.Row="1" Margin="22,18,22,20">

                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="19" Foreground="{StaticResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,18">
                                        <TextBlock Text="{Binding Format}" FontFamily="Segoe UI"
                                                   FontSize="11" Foreground="#9999AA"/>
                                        <TextBlock Text="  ·  " FontFamily="Segoe UI" FontSize="11"
                                                   Foreground="#44444E"/>
                                        <TextBlock Text="{Binding Organizer}" FontFamily="Segoe UI"
                                                   FontSize="11" Foreground="#9999AA"/>
                                    </StackPanel>

                                    <!-- Stats row: prize | slots+progress -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PRÊMIO" FontFamily="Segoe UI" FontWeight="Black"
                                                       FontSize="9" Foreground="#55555F" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Prize}" FontFamily="Segoe UI"
                                                       FontWeight="Black" FontSize="20" Foreground="#FF6A00"/>
                                        </StackPanel>

                                        <Rectangle Grid.Column="2" Fill="#22222A" VerticalAlignment="Stretch"/>

                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="VAGAS"
                                                           FontFamily="Segoe UI" FontWeight="Black"
                                                           FontSize="9" Foreground="#55555F"/>
                                                <TextBlock Grid.Column="1" FontFamily="Segoe UI"
                                                           FontWeight="Black" FontSize="11" Foreground="#CCCCD4">
                                                    <Run Text="{Binding RegisteredTeams, Mode=OneWay}"/>
                                                    <Run Text="/" Foreground="#44444E"/>
                                                    <Run Text="{Binding MaxTeams, Mode=OneWay}" Foreground="#9999AA"/>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Height="6">
                                                <Border CornerRadius="3" Background="#1A1A22"/>
                                                <ProgressBar Value="{Binding RegisteredTeams, Mode=OneWay}"
                                                             Maximum="{Binding MaxTeams, Mode=OneWay}"
                                                             BorderThickness="0" Background="Transparent"
                                                             Minimum="0">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid>
                                                                <Border CornerRadius="3" Background="Transparent"/>
                                                                <Border x:Name="PART_Track" CornerRadius="3"/>
                                                                <Border x:Name="PART_Indicator" CornerRadius="3"
                                                                        HorizontalAlignment="Left">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="#FF6A00" Offset="0"/>
                                                                            <GradientStop Color="#D7261E" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Start date row -->
                                    <Grid Margin="0,10,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="#55555F"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" FontFamily="Segoe UI" FontSize="12"
                                                   Foreground="#9999AA" VerticalAlignment="Center">
                                            <Run Text="Início em "/>
                                            <Run Text="{Binding StartDate, StringFormat={}{0:dd MMM yyyy}, Mode=OneWay}"
                                                 FontWeight="SemiBold" Foreground="#CCCCD4"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Actions -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Height="38" Cursor="Hand"
                                                Command="{Binding DataContext.DetailsCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root" CornerRadius="6"
                                                            Background="Transparent" BorderBrush="#2A2A35"
                                                            BorderThickness="1">
                                                        <TextBlock Text="DETALHES" FontFamily="Segoe UI"
                                                                   FontWeight="Black" FontSize="11"
                                                                   Foreground="#CCCCD4"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="#FF6A0080"/>
                                                            <Setter TargetName="Root" Property="Background" Value="#10FF6A00"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Grid.Column="2" Height="38" Cursor="Hand"
                                                Command="{Binding DataContext.RegisterCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root" CornerRadius="6">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FF6A00" Offset="0"/>
                                                                <GradientStop Color="#D7261E" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#FF4D00" BlurRadius="18"
                                                                              ShadowDepth="0" Opacity="0.45"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                                                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="White" VerticalAlignment="Center"
                                                           Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE710;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontFamily="Segoe UI" FontWeight="Black"
                                                           FontSize="11" Foreground="White"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="INSCREVER TIME"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                                                    <Setter Property="Text" Value="INSCRITO"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
