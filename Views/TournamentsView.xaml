<UserControl x:Class="Summit.Views.TournamentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:vm="clr-namespace:Summit.ViewModels"
             Background="Transparent" Opacity="0">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <UserControl.Resources>
        <h:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
        <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="40,32,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="CAMPEONATOS" FontFamily="Segoe UI" FontWeight="Black"
                       FontSize="36" Foreground="{StaticResource BrushTextPrimary}"/>
            <Button Grid.Column="1" Style="{StaticResource SmallButton}" VerticalAlignment="Bottom"
                    Command="{Binding CreateTournamentCommand}">
                <TextBlock Text="CRIAR CAMPEONATO" FontFamily="Segoe UI" FontWeight="Bold"
                           FontSize="11" Foreground="White"/>
            </Button>
        </Grid>
        <TextBlock Grid.Row="2" Text="Encontre, inscreva-se e compita nos melhores campeonatos da comunidade."
                   FontFamily="Segoe UI" FontSize="13" Foreground="#9AA5B5"/>

        <!-- ═══ BANNER DE TEMPORADA (placeholder, sem sistema de temporada no backend) ═══ -->
        <Border Grid.Row="4" CornerRadius="12" Padding="28,20" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2A1408" Offset="0"/>
                    <GradientStop Color="#131313" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,-120,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#28FF6A1A" Offset="0"/>
                            <GradientStop Color="#00FF6A1A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TEMPORADA ATUAL" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="SEASON 9 — RELOADED" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="20" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        <TextBlock Text="Novos torneios, mais prêmios, mais competição."
                                   FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Height="36" Padding="20,0" VerticalAlignment="Center"
                            Cursor="Hand" BorderThickness="0" Background="Transparent"
                            BorderBrush="{StaticResource BrushBorderSubtle}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Background="Transparent"
                                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="VER NOVIDADES" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="10" Foreground="{StaticResource BrushTextPrimary}"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Filtros + controles de exibição (dropdowns/toggle são só visuais por ora) -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0" ItemsSource="{Binding Filters}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FilterItem}">
                    <Button Command="{Binding DataContext.FilterCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Name}"
                            Margin="0,0,8,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" CornerRadius="6" Padding="16,7"
                                        SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#131313"/>
                                            <Setter Property="BorderBrush" Value="#212121"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                               FontWeight="Bold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9AA5B5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF6A1A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Root" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#25FF6A1A" Offset="0"/>
                                                    <GradientStop Color="#15FF3B30" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#80FF6A1A"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#60FF6A1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Dropdowns e toggle grid/lista — visuais por ora, sem lógica nova -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="6" Padding="12,7" Margin="0,0,8,0" Cursor="Hand"
                        Background="#131313" BorderBrush="#212121" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CS2" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                   Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="6" Padding="12,7" Margin="0,0,8,0" Cursor="Hand"
                        Background="#131313" BorderBrush="#212121" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mais recentes" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                   Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="6" Background="#131313" BorderBrush="#212121" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="5,0,0,5" Padding="9,7" Background="{StaticResource BrushSidebarActive}" Cursor="Hand">
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource BrushAccent}"/>
                        </Border>
                        <Rectangle Width="1" Fill="#212121"/>
                        <Border CornerRadius="0,5,5,0" Padding="9,7" Cursor="Hand">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Tournament cards -->
            <ItemsControl Grid.Row="8" ItemsSource="{Binding Filtered}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,20,20" CornerRadius="12"
                                Background="#131313" ClipToBounds="True"
                                Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#212121"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.45" Direction="270"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#80FF6A1A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.015" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.015" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.0" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- BANNER -->
                                <Grid Grid.Row="0" ClipToBounds="True">
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2A0F06" Offset="0"/>
                                                <GradientStop Color="#3A1208" Offset="0.4"/>
                                                <GradientStop Color="#1A0804" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Line X1="0" Y1="140" X2="400" Y2="0"
                                          Stroke="#20FF6A1A" StrokeThickness="80"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          IsHitTestVisible="False"/>

                                    <Ellipse Width="360" Height="360" HorizontalAlignment="Right"
                                             VerticalAlignment="Center" Margin="0,0,-120,0"
                                             IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#50FF6A1A" Offset="0"/>
                                                <GradientStop Color="#00FF6A1A" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="130" Foreground="#18FFFFFF"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,12,0" IsHitTestVisible="False"/>

                                    <Rectangle VerticalAlignment="Bottom" Height="40">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0012151B" Offset="0"/>
                                                <GradientStop Color="#131313" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <!-- Status pill -->
                                    <Border CornerRadius="4" Padding="10,5"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="16,16,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#15361F"/>
                                                <Setter Property="BorderBrush" Value="#6022C55E"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                        <Setter Property="Background" Value="#3A2A0A"/>
                                                        <Setter Property="BorderBrush" Value="#60FACC15"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                                        <Setter Property="Background" Value="#14233A"/>
                                                        <Setter Property="BorderBrush" Value="#6038BDF8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                        <Setter Property="Background" Value="#141414"/>
                                                        <Setter Property="BorderBrush" Value="#434D5F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,7,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#22C55E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                <Setter Property="Fill" Value="#FACC15"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                                                <Setter Property="Fill" Value="#38BDF8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                                <Setter Property="Fill" Value="#5A6577"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusLabel}" FontFamily="Segoe UI"
                                                       FontWeight="Black" FontSize="9">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                <Setter Property="Foreground" Value="#FACC15"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                                <Setter Property="Foreground" Value="#9AA5B5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Game tag -->
                                    <Border CornerRadius="4" Padding="8,4"
                                            Background="#0B0B0B" BorderBrush="#2A2A2A" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,16,16,0">
                                        <TextBlock Text="{Binding Game}" FontFamily="Segoe UI"
                                                   FontWeight="Bold" FontSize="10" Foreground="#CCCCD4"/>
                                    </Border>

                                    <!-- Countdown badge -->
                                    <Border CornerRadius="14" Padding="12,5"
                                            Background="#CC0B0D12" BorderBrush="#60FF6A1A"
                                            BorderThickness="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="16,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Foreground="#FF6A1A"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding CountdownLabel}" FontFamily="Segoe UI"
                                                       FontWeight="Black" FontSize="10"
                                                       Foreground="#F2F5FA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- BODY -->
                                <StackPanel Grid.Row="1" Margin="22,18,22,20">

                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="19" Foreground="{StaticResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,18">
                                        <TextBlock Text="{Binding Format}" FontFamily="Segoe UI"
                                                   FontSize="11" Foreground="#9AA5B5"/>
                                        <TextBlock Text="  ·  " FontFamily="Segoe UI" FontSize="11"
                                                   Foreground="#434D5F"/>
                                        <TextBlock Text="{Binding Organizer}" FontFamily="Segoe UI"
                                                   FontSize="11" Foreground="#9AA5B5"/>
                                    </StackPanel>

                                    <!-- Stats row: prize | slots+progress -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PRÊMIO" FontFamily="Segoe UI" FontWeight="Black"
                                                       FontSize="9" Foreground="#5A6577" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Prize}" FontFamily="Segoe UI"
                                                       FontWeight="Black" FontSize="20" Foreground="#FF6A1A"/>
                                        </StackPanel>

                                        <Rectangle Grid.Column="2" Fill="#212121" VerticalAlignment="Stretch"/>

                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="VAGAS"
                                                           FontFamily="Segoe UI" FontWeight="Black"
                                                           FontSize="9" Foreground="#5A6577"/>
                                                <TextBlock Grid.Column="1" FontFamily="Segoe UI"
                                                           FontWeight="Black" FontSize="11" Foreground="#CCCCD4">
                                                    <Run Text="{Binding RegisteredTeams, Mode=OneWay}"/>
                                                    <Run Text="/" Foreground="#434D5F"/>
                                                    <Run Text="{Binding MaxTeams, Mode=OneWay}" Foreground="#9AA5B5"/>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Height="6">
                                                <Border CornerRadius="3" Background="#141414"/>
                                                <ProgressBar Value="{Binding RegisteredTeams, Mode=OneWay}"
                                                             Maximum="{Binding MaxTeams, Mode=OneWay}"
                                                             BorderThickness="0" Background="Transparent"
                                                             Minimum="0">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid>
                                                                <Border CornerRadius="3" Background="Transparent"/>
                                                                <Border x:Name="PART_Track" CornerRadius="3"/>
                                                                <Border x:Name="PART_Indicator" CornerRadius="3"
                                                                        HorizontalAlignment="Left">
                                                                    <Border.Background>
                                                                        <StaticResource ResourceKey="BrushGradientBrand"/>
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Start date row -->
                                    <Grid Margin="0,10,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="#5A6577"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" FontFamily="Segoe UI" FontSize="12"
                                                   Foreground="#9AA5B5" VerticalAlignment="Center">
                                            <Run Text="Início em "/>
                                            <Run Text="{Binding StartDate, StringFormat={}{0:dd MMM yyyy}, Mode=OneWay}"
                                                 FontWeight="SemiBold" Foreground="#CCCCD4"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Actions -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Height="38" Cursor="Hand"
                                                Command="{Binding DataContext.DetailsCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root" CornerRadius="6"
                                                            Background="Transparent" BorderBrush="#2A2A2A"
                                                            BorderThickness="1">
                                                        <TextBlock Text="DETALHES" FontFamily="Segoe UI"
                                                                   FontWeight="Black" FontSize="11"
                                                                   Foreground="#CCCCD4"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="#80FF6A1A"/>
                                                            <Setter TargetName="Root" Property="Background" Value="#10FF6A1A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Grid.Column="2" Height="38" Cursor="Hand"
                                                Command="{Binding DataContext.RegisterCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <!-- T-12h: inscrições fechadas -->
                                                        <DataTrigger Binding="{Binding IsRegistrationOpen}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <!-- janela de check-in: dá lugar ao botão verde -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCheckInOpen}" Value="True"/>
                                                                <Condition Binding="{Binding IsRegistered}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root" CornerRadius="6"
                                                            Background="{StaticResource BrushGradientBrand}">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#FF5024" BlurRadius="18"
                                                                              ShadowDepth="0" Opacity="0.45"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                                                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="White" VerticalAlignment="Center"
                                                           Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE710;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontFamily="Segoe UI" FontWeight="Black"
                                                           FontSize="11" Foreground="White"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="INSCREVER TIME"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRegistrationOpen}" Value="False">
                                                                    <Setter Property="Text" Value="INSCRIÇÕES ENCERRADAS"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                                                    <Setter Property="Text" Value="INSCRITO"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- CHECK-IN (janela T-1h → T-30min, só p/ inscritos) -->
                                        <Button Grid.Column="2" Height="38" Cursor="Hand"
                                                Command="{Binding DataContext.CheckInCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCheckInOpen}" Value="True"/>
                                                                <Condition Binding="{Binding IsRegistered}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root" CornerRadius="6" Background="#1B7A45">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#22C55E" BlurRadius="16"
                                                                              ShadowDepth="0" Opacity="0.45"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="FAZER CHECK-IN" FontFamily="Segoe UI" FontWeight="Black"
                                                           FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </Grid>
    </ScrollViewer>
</UserControl>
