<UserControl x:Class="Summit.Views.CreateTournamentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>

        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#262C39"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FF6A1A"/>
                    <Setter Property="BorderBrush" Value="#FF6A1A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerButtonText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9AA5B5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#9AA5B5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer>
        <Grid Margin="40,28,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Back -->
            <Button Grid.Row="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Command="{Binding BackCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#9AA5B5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="VOLTAR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="10" Foreground="#9AA5B5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Grid.Row="2" Text="{Binding PageTitle}" FontFamily="Segoe UI" FontWeight="Black"
                       FontSize="28" Foreground="{StaticResource BrushTextPrimary}"/>

            <StackPanel Grid.Row="4" MaxWidth="620" HorizontalAlignment="Left">

                <TextBlock Text="NOME" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="DESCRIÇÃO" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" Height="70"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="REGIÃO" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="INÍCIO (dd/MM/yyyy HH:mm)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="FORMATO" Style="{StaticResource FieldLabel}"/>
                <ItemsControl ItemsSource="{Binding FormatOptions}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PickerButton}"
                                    Command="{Binding DataContext.SelectFormatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Value}">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource PickerButtonText}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SÉRIE (RODADAS NORMAIS)" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding SeriesOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PickerButton}"
                                            Command="{Binding DataContext.SelectSeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Value}">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource PickerButtonText}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SÉRIE (FINAL)" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding FinalSeriesOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PickerButton}"
                                            Command="{Binding DataContext.SelectFinalSeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Value}">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource PickerButtonText}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <TextBlock Text="MAP POOL (separado por vírgula, mínimo 3)" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"
                         Text="{Binding MapPoolCsv, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MÍNIMO DE TIMES" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding MinTeams, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MÁXIMO DE TIMES" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding MaxTeams, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PREMIAÇÃO" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding Prize, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TAXA DE ENTRADA (se paga)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding EntryFee, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="Entrada paga" IsChecked="{Binding IsPaidEntry}"
                          Foreground="{StaticResource BrushTextPrimary}" FontFamily="Segoe UI"
                          FontSize="12" Margin="0,0,0,18"/>

                <TextBlock Text="{Binding Message}" FontFamily="Segoe UI" FontSize="12" Foreground="#EF4444"
                           Margin="0,0,0,10" TextWrapping="Wrap"
                           Visibility="{Binding Message, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                <Button Content="{Binding SaveButtonText}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
