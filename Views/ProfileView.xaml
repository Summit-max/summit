<UserControl x:Class="Summit.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter         x:Key="BoolToVisibility"/>
        <h:InverseBoolToVisibilityConverter  x:Key="InverseBoolToVisibility"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer>
        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- â”€â”€ PROFILE HEADER CARD â”€â”€ -->
            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E1208" Offset="0"/>
                        <GradientStop Color="#1A1A22" Offset="0.4"/>
                        <GradientStop Color="#1A1A22" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF6A0050" Offset="0"/>
                        <GradientStop Color="#2A2A35" Offset="0.5"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4" Direction="270"/>
                </Border.Effect>

                <!-- Decorative glow -->
                <Grid>
                    <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Margin="-50,0,0,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#10FF6A00" Offset="0"/>
                                <GradientStop Color="#00FF6A00" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="32,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Grid Grid.Column="0" Width="84" Height="84"
                              Margin="0,0,24,0" VerticalAlignment="Top">
                            <Grid.Effect>
                                <DropShadowEffect Color="#FF6A00" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                            </Grid.Effect>

                            <!-- Steam avatar -->
                            <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Fallback (inicial) -->
                            <Border CornerRadius="42"
                                    Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVisibility}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF6A00" Offset="0"/>
                                        <GradientStop Color="#D7261E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding NicknameInitial}" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="36" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Ring -->
                            <Ellipse Stroke="#FF6A00" StrokeThickness="2" Opacity="0.65"
                                     IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="30"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <Border CornerRadius="4" Padding="8,3" Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF6A0025" Offset="0"/>
                                            <GradientStop Color="#D7261E25" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Rank}" FontFamily="Segoe UI"
                                               FontWeight="Bold" FontSize="11" Foreground="#FF6A00"/>
                                </Border>
                            </StackPanel>

                            <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#9999AA" Margin="0,0,0,10">
                                <Run Text="Steam ID: "/>
                                <Run Text="{Binding SteamId, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#55555F"/>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4" Padding="10,4" Background="#22222A"
                                        BorderBrush="#2A2A35" BorderThickness="1" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="#9999AA" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PrimaryRole}"
                                                   FontFamily="Segoe UI" FontSize="12"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- LevelBadge + Edit button -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <c:LevelBadge Level="{Binding Level}" Size="96" ShowTier="True"
                                          Margin="0,0,18,0" VerticalAlignment="Top"/>
                            <Button Style="{StaticResource SmallButton}"
                                    Command="{Binding EditCommand}" VerticalAlignment="Top"
                                    Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="EDITAR" FontFamily="Segoe UI" FontWeight="Bold"
                                               FontSize="12" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- â”€â”€ STATS GRID â”€â”€ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="K/D" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9999AA" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding KDText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="WINRATE" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9999AA" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding WinRateText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="HS%" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9999AA" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding HSText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="PARTIDAS" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9999AA" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Matches}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="VITÃ“RIAS" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9999AA" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Wins}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="MAPA FAVE" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9999AA" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding FavoriteMap}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="16" Foreground="{StaticResource BrushOrangeHot}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- â”€â”€ BIO SECTION â”€â”€ -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bio card -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="BIO" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="9" Foreground="#FF6A00"/>

                        <!-- View mode -->
                        <TextBlock Grid.Row="2" Text="{Binding Bio}" FontFamily="Segoe UI"
                                   FontSize="14" Foreground="#9999AA" TextWrapping="Wrap"
                                   Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Edit mode -->
                        <StackPanel Grid.Row="2"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding EditBio, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxMulti}"
                                     Height="80" Margin="0,0,0,12"/>
                            <TextBlock Text="ROLE" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="8" Foreground="#9999AA"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding EditRole, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="SALVAR" Style="{StaticResource SmallButton}"
                                        Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                                <Button Content="CANCELAR" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelCommand}" Height="32" Padding="16,0"
                                        FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Account info card -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CONTA" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="9" Foreground="#FF6A00" Margin="0,0,0,16"/>

                        <!-- Rows -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Steam ID" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#9999AA"/>
                            <TextBlock Grid.Column="1" Text="{Binding SteamId}" FontFamily="Consolas"
                                       FontSize="12" Foreground="{StaticResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Role" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#9999AA"/>
                            <TextBlock Grid.Column="1" Text="{Binding PrimaryRole}" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rank" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#9999AA"/>
                            <TextBlock Grid.Column="1" Text="{Binding Rank}" FontFamily="Segoe UI"
                                       FontWeight="SemiBold" FontSize="12" Foreground="#FF6A00"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mapa Favorito" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#9999AA"/>
                            <TextBlock Grid.Column="1" Text="{Binding FavoriteMap}" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- â”€â”€ BADGES â”€â”€ -->
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="3" Height="20" CornerRadius="2" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF6A00" Offset="0"/>
                                <GradientStop Color="#D7261E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="BADGES CONQUISTADAS" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Badges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="14,10" Margin="0,0,10,10"
                                    Background="#1E1E25" BorderBrush="#2A2A35" BorderThickness="1"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="20" Foreground="#FF6A00" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                                   FontWeight="Bold" FontSize="12"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding Rarity}" FontFamily="Segoe UI"
                                                   FontSize="10" Foreground="#FF6A00"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
