<UserControl x:Class="Summit.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter         x:Key="BoolToVisibility"/>
        <h:InverseBoolToVisibilityConverter  x:Key="InverseBoolToVisibility"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer>
        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── CARTÃO DE PERFIL (estilo cartão de crédito) + badge de nível ao lado ── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="ProfileCard" CornerRadius="16" Width="420" Height="240" ClipToBounds="True"
                        MouseMove="ProfileCard_MouseMove" MouseLeave="ProfileCard_MouseLeave"
                        RenderTransformOrigin="0.5,0.5">
                    <!-- Sem Projection/PlaneProjection real (não existe no runtime WPF do .NET 8) —
                         "tilt" falso via Skew+Scale 2D, reforçado por um brilho que segue o mouse. -->
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                            <SkewTransform x:Name="CardSkew" AngleX="0" AngleY="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#80FF6A1A" Offset="0"/>
                            <GradientStop Color="#30402A1E" Offset="0.5"/>
                            <GradientStop Color="#60FF6A1A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1.5</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="10" Opacity="0.5" Direction="270"/>
                    </Border.Effect>

                    <Grid>
                        <!-- Base do "material" do cartão — não é só a foto, é a superfície -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1C1008" Offset="0"/>
                                    <GradientStop Color="#141414" Offset="0.55"/>
                                    <GradientStop Color="#100D0A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Friso diagonal (textura de "cartão" — like um selo holográfico sutil) -->
                        <Rectangle Width="70" Opacity="0.06" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="24"/>
                            </Rectangle.RenderTransform>
                            <Rectangle.Margin>
                                <Thickness Left="260" Top="-140" Right="0" Bottom="-140"/>
                            </Rectangle.Margin>
                        </Rectangle>

                        <!-- Brilho que acompanha o cursor -->
                        <Border x:Name="Glint" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="GlintBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                    <GradientStop Color="#50FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="28,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Esquerda: avatar + nome + role/time, ancorados embaixo (estilo "titular do cartão") -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <Grid Width="72" Height="72" Margin="0,0,0,14">
                                    <Grid.Effect>
                                        <DropShadowEffect Color="#FF6A1A" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                                    </Grid.Effect>
                                    <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Border CornerRadius="36"
                                            Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVisibility}}"
                                            Background="{StaticResource BrushGradientBrandD}">
                                        <TextBlock Text="{Binding NicknameInitial}" FontFamily="Segoe UI"
                                                   FontWeight="Black" FontSize="30" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse Stroke="White" StrokeThickness="2" Opacity="0.85" IsHitTestVisible="False"/>
                                </Grid>

                                <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="24" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border CornerRadius="4" Padding="7,2" Background="#33FF6A1A" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Rank}" FontFamily="Segoe UI"
                                                   FontWeight="Bold" FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                                    </Border>
                                    <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#D8DADF" VerticalAlignment="Center">
                                        <Run Text="{Binding PrimaryRole, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding TeamName, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Direita: badges no topo (estilo bandeira do cartão) + editar no rodapé -->
                            <Grid Grid.Column="1">
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <ItemsControl ItemsSource="{Binding Badges}" HorizontalAlignment="Right">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="32" Height="32" CornerRadius="16" Margin="6,0,0,0"
                                                        Background="#992A1408" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                                                        ToolTip="{Binding Name}">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{StaticResource BrushAccent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" Width="200" Background="#40FF6A1A" Margin="0,10,0,4" HorizontalAlignment="Right"/>
                                    <TextBlock Text="BADGES" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9"
                                               Foreground="#B5BAC2" HorizontalAlignment="Right"/>
                                </StackPanel>

                                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Style="{StaticResource SmallButton}" Command="{Binding EditCommand}"
                                        Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                                        <TextBlock Text="EDITAR" FontFamily="Segoe UI" FontWeight="Bold"
                                                   FontSize="12" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Badge de nível, fora do cartão -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <c:LevelBadge Level="{Binding Level}" Size="100" ShowTier="True"/>
                </StackPanel>
            </Grid>

            <!-- â”€â”€ STATS GRID â”€â”€ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="K/D" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9AA5B5" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding KDText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="WINRATE" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9AA5B5" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding WinRateText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="HS%" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9AA5B5" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding HSText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="PARTIDAS" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9AA5B5" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Matches}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="VITÓRIAS" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9AA5B5" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Wins}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="24" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="MAPA FAVE" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="8" Foreground="#9AA5B5" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding FavoriteMap}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="16" Foreground="{StaticResource BrushAccent}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- â”€â”€ BIO SECTION â”€â”€ -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bio card -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="BIO" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="9" Foreground="#FF6A1A"/>

                        <!-- View mode -->
                        <TextBlock Grid.Row="2" Text="{Binding Bio}" FontFamily="Segoe UI"
                                   FontSize="14" Foreground="#9AA5B5" TextWrapping="Wrap"
                                   Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Edit mode -->
                        <StackPanel Grid.Row="2"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding EditBio, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxMulti}"
                                     Height="80" Margin="0,0,0,12"/>
                            <TextBlock Text="ROLE" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="8" Foreground="#9AA5B5"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding EditRole, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>
                            <TextBlock Text="PAÍS" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="8" Foreground="#9AA5B5"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding EditCountry, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>
                            <TextBlock Text="URL DO AVATAR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="8" Foreground="#9AA5B5"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding EditAvatarUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="SALVAR" Style="{StaticResource SmallButton}"
                                        Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                                <Button Content="CANCELAR" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelCommand}" Height="32" Padding="16,0"
                                        FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Account info card -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CONTA" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="9" Foreground="#FF6A1A" Margin="0,0,0,16"/>

                        <!-- Rows -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Steam ID" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#9AA5B5"/>
                            <TextBlock Grid.Column="1" Text="{Binding SteamId}" FontFamily="Consolas"
                                       FontSize="12" Foreground="{StaticResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Role" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#9AA5B5"/>
                            <TextBlock Grid.Column="1" Text="{Binding PrimaryRole}" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rank" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#9AA5B5"/>
                            <TextBlock Grid.Column="1" Text="{Binding Rank}" FontFamily="Segoe UI"
                                       FontWeight="SemiBold" FontSize="12" Foreground="#FF6A1A"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mapa Favorito" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#9AA5B5"/>
                            <TextBlock Grid.Column="1" Text="{Binding FavoriteMap}" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- â”€â”€ BADGES â”€â”€ -->
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="3" Height="20" CornerRadius="2" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF6A1A" Offset="0"/>
                                <GradientStop Color="#FF3B30" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="BADGES CONQUISTADAS" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Badges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="14,10" Margin="0,0,10,10"
                                    Background="#181D26" BorderBrush="#262C39" BorderThickness="1"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="20" Foreground="#FF6A1A" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                                   FontWeight="Bold" FontSize="12"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding Rarity}" FontFamily="Segoe UI"
                                                   FontSize="10" Foreground="#FF6A1A"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
