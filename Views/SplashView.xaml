<Window x:Class="Summit.Views.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Summit" Width="620" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="16" ClipToBounds="True">
        <Grid>
            <!-- BG -->
            <Rectangle RadiusX="16" RadiusY="16">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0B0C0E" Offset="0"/>
                        <GradientStop Color="#120B08" Offset="0.65"/>
                        <GradientStop Color="#200A05" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Lava horizon -->
            <Rectangle Height="120" VerticalAlignment="Bottom" Opacity="0.5">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#55FF3B30" Offset="0"/>
                        <GradientStop Color="#00FF3B30" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Glow pulsante atrás da logo -->
            <Ellipse Width="360" Height="360" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,-70,0,0" x:Name="Glow"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#30FF3B30" Offset="0"/>
                        <GradientStop Color="#00FF3B30" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.9" To="1.12" Duration="0:0:1.4"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.9" To="1.12" Duration="0:0:1.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!-- Cantos HUD -->
            <Border Width="24" Height="24" BorderBrush="#FF3B30" BorderThickness="2,2,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Opacity="0.75"/>
            <Border Width="24" Height="24" BorderBrush="#FF3B30" BorderThickness="0,2,2,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Opacity="0.75"/>
            <Border Width="24" Height="24" BorderBrush="#FF3B30" BorderThickness="2,0,0,2"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Opacity="0.75"/>
            <Border Width="24" Height="24" BorderBrush="#FF3B30" BorderThickness="0,0,2,2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Opacity="0.75"/>

            <!-- Lockup central -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0"
                        x:Name="LogoPanel" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform><ScaleTransform/></StackPanel.RenderTransform>
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.55" BeginTime="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.86" To="1" Duration="0:0:0.55" BeginTime="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.86" To="1" Duration="0:0:0.55" BeginTime="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>

                <Image Source="/Assets/logo.png" Height="150" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect Color="#FF3B30" BlurRadius="36" ShadowDepth="0" Opacity="0.75"/>
                    </Image.Effect>
                </Image>

                <TextBlock Text="SUMMIT" FontFamily="Segoe UI" FontWeight="Black" FontSize="46"
                           Foreground="#F2F5FA" HorizontalAlignment="Center" Margin="0,10,0,2"/>

                <TextBlock FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                           HorizontalAlignment="Center">
                    <Run Text="⟪ " Foreground="#FF3B30"/><Run Text="ELEVATE YOUR GAME." Foreground="#FF6A1A"/><Run Text=" ⟫" Foreground="#FF3B30"/>
                </TextBlock>

                <TextBlock FontFamily="Segoe UI" FontWeight="Bold" FontSize="9"
                           HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Run Text="FOCO" Foreground="#9AA5B5"/><Run Text="  //  " Foreground="#FF3B30"/><Run Text="PRECISÃO" Foreground="#9AA5B5"/><Run Text="  //  " Foreground="#FF3B30"/><Run Text="DOMINAÇÃO" Foreground="#9AA5B5"/>
                </TextBlock>
            </StackPanel>

            <!-- Loading -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,34">
                <Border Width="260" Height="3" CornerRadius="1.5" Background="#22150F">
                    <Border x:Name="LoadingBar" HorizontalAlignment="Left" CornerRadius="1.5"
                            Width="0" Height="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6A1A" Offset="0"/>
                                <GradientStop Color="#FF3B30" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF3B30" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         From="0" To="260" Duration="0:0:1.6" BeginTime="0:0:0.5">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Border>
                <TextBlock Text="SUMMIT ALPHA · v0.2" FontFamily="Consolas" FontSize="9"
                           Foreground="#4A3A34" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
