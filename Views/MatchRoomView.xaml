<UserControl x:Class="Summit.Views.MatchRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="PlayerRowTpl">
            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                    Background="#12151B" BorderBrush="#1E232E" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <c:LevelBadge Level="{Binding Level}" Size="34" ShowTier="False" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="12" Foreground="#F2F5FA" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PrimaryRole}" FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#5A6577"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36,26,36,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Voltar -->
            <Button Grid.Row="0" HorizontalAlignment="Left" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="#9AA5B5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="VOLTAR" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                               Foreground="#9AA5B5" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Header: Time A vs Time B -->
            <Border Grid.Row="2" CornerRadius="14" Padding="28,20" Background="#12151B"
                    BorderBrush="#1E232E" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0"
                                Background="{StaticResource BrushGradientBrandD}">
                            <TextBlock Text="{Binding TeamATag}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="14" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TeamA.Name}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="18" Foreground="#F2F5FA"/>
                            <TextBlock Text="{Binding TeamATag}" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#FF6A1A"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0">
                        <TextBlock Text="VS" FontFamily="Segoe UI" FontWeight="Black" FontSize="24"
                                   Foreground="#5A6577" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusLine}" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="11" Foreground="#FF6A1A" HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding TeamB.Name}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="18" Foreground="#F2F5FA" TextAlignment="Right"/>
                            <TextBlock Text="{Binding TeamBTag}" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#FF6A1A" TextAlignment="Right"/>
                        </StackPanel>
                        <Border Width="52" Height="52" CornerRadius="10" Margin="14,0,0,0"
                                Background="#1E232E">
                            <TextBlock Text="{Binding TeamBTag}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="14" Foreground="#9AA5B5" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Corpo: elenco A | veto/servidor | elenco B -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <!-- Elenco A -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TeamATag}" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="11" Foreground="#5A6577" Margin="2,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding TeamA.Members}"
                                  ItemTemplate="{StaticResource PlayerRowTpl}"/>
                </StackPanel>

                <!-- Centro -->
                <StackPanel Grid.Column="2">

                    <!-- VETO DE MAPAS -->
                    <Border CornerRadius="12" Padding="22" Background="#0F1116"
                            BorderBrush="#1E232E" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                        Background="{StaticResource BrushGradientBrandV}"/>
                                <TextBlock Text="VETO DE MAPAS" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="12" Foreground="#F2F5FA" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Maps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,10,10" Height="72" Cursor="Hand"
                                                Command="{Binding DataContext.BanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Map}"
                                                IsEnabled="{Binding IsClickable}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root" CornerRadius="8"
                                                            BorderThickness="1" SnapsToDevicePixels="True">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#181D26"/>
                                                                <Setter Property="BorderBrush" Value="#262C39"/>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Map}" FontFamily="Segoe UI"
                                                                       FontWeight="Black" FontSize="13"
                                                                       HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#F2F5FA"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                                <Setter Property="Foreground" Value="#3A4252"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDecider}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FF6A1A"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding StateLabel}" FontFamily="Segoe UI"
                                                                       FontWeight="Bold" FontSize="9"
                                                                       HorizontalAlignment="Center" Margin="0,4,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#FF3B30"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDecider}" Value="True">
                                                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsDecider}" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="#22C55E"/>
                                                            <Setter TargetName="Root" Property="Background" Value="#12261B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsAvailable}" Value="False"/>
                                                                <Condition Binding="{Binding IsDecider}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="#40FF3B30"/>
                                                        </MultiDataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="#FF6A1A"/>
                                                            <Setter TargetName="Root" Property="Background" Value="#221610"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- SERVIDOR PRONTO -->
                    <Border CornerRadius="12" Padding="24" Margin="0,16,0,0"
                            Background="#150F0C" BorderBrush="#60FF6A1A" BorderThickness="1"
                            Visibility="{Binding HasRoom, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="SERVIDOR PRONTO" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="12" Foreground="#F2F5FA"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MAPA" FontSize="9" FontWeight="Bold" Foreground="#5A6577" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding Room.Map}" FontSize="17" FontWeight="Black"
                                               Foreground="#FF6A1A" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="IP" FontSize="9" FontWeight="Bold" Foreground="#5A6577" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding Room.ServerIp}" FontSize="13" FontWeight="Bold"
                                               Foreground="#F2F5FA" FontFamily="Consolas" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SENHA" FontSize="9" FontWeight="Bold" Foreground="#5A6577" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding Room.ServerPassword}" FontSize="13" FontWeight="Bold"
                                               Foreground="#F2F5FA" FontFamily="Consolas" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Button Height="44" HorizontalAlignment="Left" MinWidth="260" Padding="22,0"
                                    Cursor="Hand" Command="{Binding ConnectCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root" CornerRadius="6" Background="{StaticResource BrushGradientBrand}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF3B30" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding ConnectLabel}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Elenco B -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{Binding TeamBTag}" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="11" Foreground="#5A6577" Margin="2,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding TeamB.Members}"
                                  ItemTemplate="{StaticResource PlayerRowTpl}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
