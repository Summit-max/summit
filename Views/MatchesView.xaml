<UserControl x:Class="Summit.Views.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer>
        <Grid Margin="40,28,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="PARTIDAS" FontFamily="Segoe UI" FontWeight="Black"
                       FontSize="32" Foreground="{StaticResource BrushTextPrimary}"/>
            <TextBlock Grid.Row="2" FontFamily="Segoe UI" FontSize="13" Foreground="#9AA5B5">
                <Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" partidas jogadas — clique numa para ver o scoreboard"/>
            </TextBlock>

            <!-- MATCH LIST -->
            <Border Grid.Row="4" CornerRadius="10" Background="#12151B"
                    BorderBrush="#1E232E" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#1D222C" BorderThickness="0,0,0,1" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenMatchCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding Id}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#171B22"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Height="72" Margin="20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="4" Height="36" CornerRadius="2" Margin="0,0,16,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Won}" Value="True">
                                                        <Setter Property="Background" Value="#22C55E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding WonLabel}"
                                               FontFamily="Segoe UI" FontWeight="Black" FontSize="14"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Won}" Value="True">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" Text="{Binding Map}"
                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                               Foreground="#9AA5B5" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="{Binding Score}"
                                               FontFamily="Segoe UI" FontWeight="Black" FontSize="18"
                                               Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe UI" FontSize="13">
                                            <Run Text="{Binding TeamATag, Mode=OneWay}" FontWeight="Bold" Foreground="#F2F5FA"/>
                                            <Run Text=" vs " Foreground="#434D5F"/>
                                            <Run Text="{Binding TeamBTag, Mode=OneWay}" FontWeight="Bold" Foreground="#F2F5FA"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TournamentName}" FontFamily="Segoe UI"
                                                   FontSize="10" Foreground="#FF6A1A" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="K/D/A" FontFamily="Segoe UI" FontWeight="Black"
                                                   FontSize="9" Foreground="#5A6577" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding KDA}" FontFamily="Segoe UI" FontWeight="Black"
                                                   FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                        <TextBlock Text="ADR" FontFamily="Segoe UI" FontWeight="Black"
                                                   FontSize="9" Foreground="#5A6577" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding AdrLabel}" FontFamily="Segoe UI" FontWeight="Black"
                                                   FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="7" Text="{Binding DateLabel}"
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#5A6577"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="8" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="#434D5F" VerticalAlignment="Center"
                                               Margin="16,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
