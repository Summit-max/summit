<UserControl x:Class="Summit.Views.RankingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="40,32,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="RANKING" FontFamily="Segoe UI" FontWeight="Black"
                   FontSize="36" Foreground="{StaticResource BrushTextPrimary}"/>
        <TextBlock Grid.Row="2" Text="{Binding HeaderSubtitle}"
                   FontFamily="Segoe UI" FontSize="13" Foreground="#9AA5B5"/>

        <!-- Toggle tabs -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Command="{Binding ShowPlayersCommand}" Margin="0,0,10,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" Padding="20,10"
                                Background="#12151B" BorderBrush="#1E232E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9AA5B5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowingPlayers}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF6A00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="JOGADORES" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9AA5B5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowingPlayers}" Value="True">
                                                    <Setter Property="Foreground" Value="#F2F5FA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding ShowingPlayers}" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#30FF6A00" Offset="0"/>
                                            <GradientStop Color="#20D7261E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#80FF6A00"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#60FF6A00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Command="{Binding ShowTeamsCommand}" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" Padding="20,10"
                                Background="#12151B" BorderBrush="#1E232E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9AA5B5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowingTeams}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF6A00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="TIMES" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9AA5B5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowingTeams}" Value="True">
                                                    <Setter Property="Foreground" Value="#F2F5FA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding ShowingTeams}" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#30FF6A00" Offset="0"/>
                                            <GradientStop Color="#20D7261E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#80FF6A00"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#60FF6A00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- ═══════════════════════════════════════════ PODIUM ═══════════════════════════════════════════ -->
        <Border Grid.Row="6" Height="450" CornerRadius="16" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#10131C" Offset="0"/>
                    <GradientStop Color="#12151B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#50FF6A00" Offset="0"/>
                    <GradientStop Color="#1E232E" Offset="0.5"/>
                    <GradientStop Color="#50D7261E" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <Grid>
                <!-- Decorative glow -->
                <Ellipse Width="700" Height="700" HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="0,-200,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#22FFD700" Offset="0"/>
                            <GradientStop Color="#00FFD700" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- ═════ PLAYERS PODIUM ═════ -->
                <Grid Visibility="{Binding ShowingPlayers, Converter={StaticResource BoolToVisibility}}"
                      Margin="40,30,40,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 2º lugar -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom"
                                DataContext="{Binding Second}">
                        <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Ellipse Width="110" Height="110" Fill="#15C0C0C0" IsHitTestVisible="False"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E0E0E0" Offset="0"/>
                                        <GradientStop Color="#8A8A8A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Margin="3">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Border Margin="3" CornerRadius="48" Background="#141821">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding InitialLetter}" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="36" Foreground="#C0C0C0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TeamTag}" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#9AA5B5" HorizontalAlignment="Center" Margin="0,3,0,8"/>

                        <Border CornerRadius="8" Padding="14,6" HorizontalAlignment="Center"
                                Background="#0B0D12" BorderBrush="#40C0C0C0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ELO " FontFamily="Segoe UI" FontWeight="Bold"
                                           FontSize="10" Foreground="#9AA5B5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EloText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="12" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Base 2 -->
                        <Border Height="88" CornerRadius="10,10,0,0" Margin="16,20,16,0"
                                ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E0E0E0" Offset="0"/>
                                    <GradientStop Color="#707078" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="2" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="56" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.92"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 1º lugar -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom"
                                DataContext="{Binding First}">
                        <!-- Crown -->
                        <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="34" Foreground="#FFD700" HorizontalAlignment="Center"
                                   Margin="0,0,0,6">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Ellipse Width="140" Height="140" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#55FFD700" Offset="0"/>
                                        <GradientStop Color="#00FFD700" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFE66B" Offset="0"/>
                                        <GradientStop Color="#FFA500" Offset="0.5"/>
                                        <GradientStop Color="#D77A00" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FFD700" BlurRadius="28" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Margin="4">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Border Margin="4" CornerRadius="60" Background="#1A1004">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding InitialLetter}" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="46" Foreground="#FFD700"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="20" Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TeamTag}" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#FFD700" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,4,0,10"/>

                        <Border CornerRadius="10" Padding="18,7" HorizontalAlignment="Center"
                                Background="#1A1004" BorderBrush="#60FFD700" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ELO " FontFamily="Segoe UI" FontWeight="Bold"
                                           FontSize="11" Foreground="#9AA5B5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EloText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="14" Foreground="#FFD700" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Base 1 (maior e dourada) -->
                        <Border Height="130" CornerRadius="10,10,0,0" Margin="10,22,10,0"
                                ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFE66B" Offset="0"/>
                                    <GradientStop Color="#FFA500" Offset="0.5"/>
                                    <GradientStop Color="#9C5A00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="24"
                                                  ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="1" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="92" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.95"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 3º lugar -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom"
                                DataContext="{Binding Third}">
                        <Grid Width="90" Height="90" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Ellipse Width="104" Height="104" Fill="#15CD7F32" IsHitTestVisible="False"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E9A96B" Offset="0"/>
                                        <GradientStop Color="#8B5A2B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Margin="3">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Border Margin="3" CornerRadius="45" Background="#141821">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding InitialLetter}" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="34" Foreground="#CD7F32"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TeamTag}" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#9AA5B5" HorizontalAlignment="Center" Margin="0,3,0,8"/>

                        <Border CornerRadius="8" Padding="14,6" HorizontalAlignment="Center"
                                Background="#0B0D12" BorderBrush="#40CD7F32" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ELO " FontFamily="Segoe UI" FontWeight="Bold"
                                           FontSize="10" Foreground="#9AA5B5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EloText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="12" Foreground="#CD7F32" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Base 3 -->
                        <Border Height="62" CornerRadius="10,10,0,0" Margin="16,20,16,0"
                                ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E9A96B" Offset="0"/>
                                    <GradientStop Color="#6B3E1A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="3" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="44" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.92"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ═════ TEAMS PODIUM ═════ -->
                <Grid Visibility="{Binding ShowingTeams, Converter={StaticResource BoolToVisibility}}"
                      Margin="40,30,40,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 2º time -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" DataContext="{Binding SecondTeam}">
                        <Border Width="96" Height="96" CornerRadius="16" HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E0E0E0" Offset="0"/>
                                    <GradientStop Color="#8A8A8A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding Tag}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="26" Foreground="#0B0D12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="15" Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#9AA5B5"
                                   HorizontalAlignment="Center" Margin="0,3,0,8">
                            <Run Text="{Binding TournamentsWon, Mode=OneWay}"/>
                            <Run Text=" títulos"/>
                        </TextBlock>
                        <Border CornerRadius="8" Padding="14,6" HorizontalAlignment="Center"
                                Background="#0B0D12" BorderBrush="#40C0C0C0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ELO " FontFamily="Segoe UI" FontWeight="Bold"
                                           FontSize="10" Foreground="#9AA5B5"/>
                                <TextBlock Text="{Binding EloText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="12" Foreground="#C0C0C0"/>
                            </StackPanel>
                        </Border>
                        <Border Height="88" CornerRadius="10,10,0,0" Margin="16,20,16,0" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E0E0E0" Offset="0"/>
                                    <GradientStop Color="#707078" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="2" FontFamily="Segoe UI" FontWeight="Black" FontSize="56"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.92"/>
                        </Border>
                    </StackPanel>

                    <!-- 1º time -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" DataContext="{Binding FirstTeam}">
                        <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                   Foreground="#FFD700" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Border Width="120" Height="120" CornerRadius="20"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFE66B" Offset="0"/>
                                    <GradientStop Color="#FFA500" Offset="0.5"/>
                                    <GradientStop Color="#D77A00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="28" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <TextBlock Text="{Binding Tag}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="32" Foreground="#1A1004"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="18" Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#FFD700" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,4,0,10">
                            <Run Text="{Binding TournamentsWon, Mode=OneWay}"/>
                            <Run Text=" títulos"/>
                        </TextBlock>
                        <Border CornerRadius="10" Padding="18,7" HorizontalAlignment="Center"
                                Background="#1A1004" BorderBrush="#60FFD700" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ELO " FontFamily="Segoe UI" FontWeight="Bold"
                                           FontSize="11" Foreground="#9AA5B5"/>
                                <TextBlock Text="{Binding EloText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="14" Foreground="#FFD700"/>
                            </StackPanel>
                        </Border>
                        <Border Height="130" CornerRadius="10,10,0,0" Margin="10,22,10,0" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFE66B" Offset="0"/>
                                    <GradientStop Color="#FFA500" Offset="0.5"/>
                                    <GradientStop Color="#9C5A00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <TextBlock Text="1" FontFamily="Segoe UI" FontWeight="Black" FontSize="92"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.95"/>
                        </Border>
                    </StackPanel>

                    <!-- 3º time -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" DataContext="{Binding ThirdTeam}">
                        <Border Width="90" Height="90" CornerRadius="16"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E9A96B" Offset="0"/>
                                    <GradientStop Color="#8B5A2B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding Tag}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="24" Foreground="#1A0A04"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="15" Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#9AA5B5"
                                   HorizontalAlignment="Center" Margin="0,3,0,8">
                            <Run Text="{Binding TournamentsWon, Mode=OneWay}"/>
                            <Run Text=" títulos"/>
                        </TextBlock>
                        <Border CornerRadius="8" Padding="14,6" HorizontalAlignment="Center"
                                Background="#0B0D12" BorderBrush="#40CD7F32" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ELO " FontFamily="Segoe UI" FontWeight="Bold"
                                           FontSize="10" Foreground="#9AA5B5"/>
                                <TextBlock Text="{Binding EloText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="12" Foreground="#CD7F32"/>
                            </StackPanel>
                        </Border>
                        <Border Height="62" CornerRadius="10,10,0,0" Margin="16,20,16,0" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E9A96B" Offset="0"/>
                                    <GradientStop Color="#6B3E1A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="3" FontFamily="Segoe UI" FontWeight="Black" FontSize="44"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.92"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Section header -->
        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <Border Width="3" Height="18" CornerRadius="2" Margin="0,0,12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF6A00" Offset="0"/>
                        <GradientStop Color="#D7261E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock FontFamily="Segoe UI" FontWeight="Black" FontSize="13"
                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="TOP JOGADORES"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowingTeams}" Value="True">
                                <Setter Property="Text" Value="TOP TIMES"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Players list -->
        <ItemsControl Grid.Row="10" ItemsSource="{Binding RestPlayers}"
                      Visibility="{Binding ShowingPlayers, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="18,14" CornerRadius="10"
                            Background="#12151B" BorderBrush="#1E232E" BorderThickness="1"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#60FF6A00"/>
                                        <Setter Property="Background" Value="#171B22"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>

                            <!-- Position square -->
                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF6A00" Offset="0"/>
                                        <GradientStop Color="#D7261E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF4D00" BlurRadius="14"
                                                      ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding Position}" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="20" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Avatar -->
                            <Grid Grid.Column="2" Width="44" Height="44">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Border CornerRadius="22">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Background" Value="#141821"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding InitialLetter}" FontFamily="Segoe UI"
                                               FontWeight="Black" FontSize="16" Foreground="#FF6A00"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Ellipse Stroke="#1E232E" StrokeThickness="1" IsHitTestVisible="False"/>
                            </Grid>

                            <!-- Nickname + team -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Country}" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI"
                                               FontWeight="Black" FontSize="15"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               VerticalAlignment="Center"/>
                                    <c:LevelBadge Level="{Binding Level}" Size="28" ShowTier="False"
                                                  Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding TeamTag}" FontFamily="Segoe UI"
                                               FontWeight="Bold" FontSize="11" Foreground="#FF6A00"/>
                                    <Rectangle Width="1" Height="10" Fill="#2E3543" Margin="8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Rank}" FontFamily="Segoe UI"
                                               FontSize="11" Foreground="#9AA5B5"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- K/D -->
                            <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="K/D" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="9" Foreground="#5A6577" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding KDText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="14" Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Winrate -->
                            <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="WIN" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="9" Foreground="#5A6577" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding WinRateText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="14" Foreground="#22C55E"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- ELO -->
                            <StackPanel Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="ELO" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="9" Foreground="#5A6577" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding EloText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="14" Foreground="#FF6A00"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Teams list -->
        <ItemsControl Grid.Row="10" ItemsSource="{Binding RestTeams}"
                      Visibility="{Binding ShowingTeams, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="18,14" CornerRadius="10"
                            Background="#12151B" BorderBrush="#1E232E" BorderThickness="1"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#60FF6A00"/>
                                        <Setter Property="Background" Value="#171B22"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>

                            <!-- Position square -->
                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF6A00" Offset="0"/>
                                        <GradientStop Color="#D7261E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF4D00" BlurRadius="14"
                                                      ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding Position}" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="20" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Logo square -->
                            <Border Grid.Column="2" Width="44" Height="44" CornerRadius="10"
                                    Background="#171B22" BorderBrush="#262C39" BorderThickness="1">
                                <TextBlock Text="{Binding Tag}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="13" Foreground="#FF6A00"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Name + country -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Country}" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                               FontWeight="Black" FontSize="15"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding TournamentsWon}" FontFamily="Segoe UI"
                                               FontWeight="Black" FontSize="11" Foreground="#FFD700"/>
                                    <TextBlock Text=" títulos" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#9AA5B5"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Matches -->
                            <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="PARTIDAS" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="9" Foreground="#5A6577" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Matches}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="14" Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Winrate -->
                            <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="WIN" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="9" Foreground="#5A6577" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding WinRateText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="14" Foreground="#22C55E"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- ELO -->
                            <StackPanel Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="ELO" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="9" Foreground="#5A6577" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding EloText}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="14" Foreground="#FF6A00"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
    </ScrollViewer>
</UserControl>
