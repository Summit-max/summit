<Window x:Class="Summit.Views.MainShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Summit.ViewModels"
        Title="Summit"
        Width="1280" Height="800"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="12" ClipToBounds="True">
        <Grid Background="{StaticResource BrushBgDark}">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="220"/>
                <!-- Main content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════ SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}"
                    BorderBrush="#1A1A22" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Border Grid.Row="0" Padding="20,0" BorderBrush="#1A1A22" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="5" Height="28" CornerRadius="2" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF6A00" Offset="0"/>
                                        <GradientStop Color="#D7261E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="SUMMIT" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="18" Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav items -->
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SidebarItem}">
                                    <Button Command="{Binding Command}"
                                            Style="{StaticResource SidebarNavButton}">
                                        <Grid>
                                            <!-- Active left bar -->
                                            <Border Width="3" HorizontalAlignment="Left" CornerRadius="0,2,2,0"
                                                    Margin="-12,0,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FF6A00" Offset="0"/>
                                                        <GradientStop Color="#D7261E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Active bg -->
                                            <Border CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BrushSidebarActive}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Icon + label -->
                                            <StackPanel Orientation="Horizontal" Margin="12,0">
                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                           VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushOrangeHot}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- User card at bottom -->
                    <Border Grid.Row="2" Margin="12,0,12,16" CornerRadius="8"
                            Background="#1A1A22" BorderBrush="#22222A" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar placeholder -->
                            <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF6A00" Offset="0"/>
                                        <GradientStop Color="#D7261E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding UserNickname[0]}"
                                           FontFamily="Segoe UI" FontWeight="Black" FontSize="15"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserNickname}" FontFamily="Segoe UI"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UserRank}" FontFamily="Segoe UI"
                                           FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════ CONTENT AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Topbar -->
                <Border Grid.Row="0" Background="{StaticResource BrushBgSidebar}"
                        BorderBrush="#1A1A22" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0">
                        <TextBlock Text="{Binding PageTitle}" VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontWeight="Black" FontSize="13"
                                   Foreground="{StaticResource BrushTextSecondary}"
/>

                        <!-- Window controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource TitleBarButton}" Command="{Binding MinimizeCommand}">
                                <TextBlock Text="—" FontSize="12" Foreground="#9999AA"/>
                            </Button>
                            <Button Style="{StaticResource TitleBarButton}" Command="{Binding MaximizeCommand}">
                                <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Foreground="#9999AA"/>
                            </Button>
                            <Button Style="{StaticResource TitleBarButtonClose}" Command="{Binding CloseCommand}">
                                <TextBlock Text="✕" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding CurrentView}" Focusable="False"/>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Border>
</Window>
