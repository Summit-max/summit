<UserControl x:Class="Summit.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9AA5B5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#141821"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer>
        <Grid Margin="40,28,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="AMIGOS" FontFamily="Segoe UI" FontWeight="Black"
                       FontSize="32" Foreground="{StaticResource BrushTextPrimary}"/>

            <!-- Add friend box -->
            <Border Grid.Row="2" CornerRadius="10" Padding="18,14" Background="#12151B"
                    BorderBrush="#1E232E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ADICIONAR POR NICK" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="10" Foreground="#FFB300" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SearchNickname, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{StaticResource SmallButton}"
                                Command="{Binding SendRequestCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="ENVIAR PEDIDO" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="11" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding SearchMessage}" FontFamily="Segoe UI" FontSize="11"
                               Foreground="#9AA5B5" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tabs -->
            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <Button Style="{StaticResource TabButton}" Command="{Binding ShowFriendsCommand}">
                    <Button.Background>
                        <Binding Path="IsFriendsTab">
                            <Binding.Converter>
                                <h:BoolToBrushConverter TrueBrush="#1D222C" FalseBrush="Transparent"/>
                            </Binding.Converter>
                        </Binding>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AMIGOS  " VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="7,2" Background="#30FFB300">
                            <TextBlock Text="{Binding FriendsCountLabel}" Foreground="#FFB300" FontWeight="Black" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TabButton}" Command="{Binding ShowIncomingCommand}">
                    <Button.Background>
                        <Binding Path="IsIncomingTab">
                            <Binding.Converter>
                                <h:BoolToBrushConverter TrueBrush="#1D222C" FalseBrush="Transparent"/>
                            </Binding.Converter>
                        </Binding>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PEDIDOS  " VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="7,2" Background="#30FACC15">
                            <TextBlock Text="{Binding IncomingCountLabel}" Foreground="#FACC15" FontWeight="Black" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TabButton}" Command="{Binding ShowOutgoingCommand}">
                    <Button.Background>
                        <Binding Path="IsOutgoingTab">
                            <Binding.Converter>
                                <h:BoolToBrushConverter TrueBrush="#1D222C" FalseBrush="Transparent"/>
                            </Binding.Converter>
                        </Binding>
                    </Button.Background>
                    <TextBlock Text="ENVIADOS"/>
                </Button>
                <Button Style="{StaticResource TabButton}" Command="{Binding ShowTeamInvitesCommand}">
                    <Button.Background>
                        <Binding Path="IsTeamInvitesTab">
                            <Binding.Converter>
                                <h:BoolToBrushConverter TrueBrush="#1D222C" FalseBrush="Transparent"/>
                            </Binding.Converter>
                        </Binding>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CONVITES DE TIME  " VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="7,2" Background="#30FFB300">
                            <TextBlock Text="{Binding TeamInvitesCountLabel}" Foreground="#FFB300" FontWeight="Black" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- FRIENDS LIST -->
            <ItemsControl Grid.Row="6" ItemsSource="{Binding Friends}"
                          Visibility="{Binding IsFriendsTab, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8"
                                Background="#12151B" BorderBrush="#1E232E" BorderThickness="1" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.ViewPlayerCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding Id}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <c:LevelBadge Grid.Column="0" Level="{Binding Level}" Size="44" ShowTier="False" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Country}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI" FontWeight="Black"
                                                   FontSize="14" Foreground="{StaticResource BrushTextPrimary}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Rank}" FontFamily="Segoe UI" FontSize="11" Foreground="#FFB300" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="3" Command="{Binding DataContext.RemoveFriendCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        Background="Transparent" BorderThickness="1" BorderBrush="#3A2A30"
                                        Padding="12,4" Cursor="Hand" ToolTip="Remover amizade">
                                    <TextBlock Text="REMOVER" FontFamily="Segoe UI" FontWeight="Bold"
                                               FontSize="10" Foreground="#EF4444"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- INCOMING -->
            <ItemsControl Grid.Row="6" ItemsSource="{Binding Incoming}"
                          Visibility="{Binding IsIncomingTab, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8"
                                Background="#12151B" BorderBrush="#1E232E" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <c:LevelBadge Grid.Column="0" Level="{Binding Requester.Level}" Size="44" ShowTier="False" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Requester.Nickname}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding Requester.Rank}" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#FFB300" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SmallButton}"
                                        Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}" Margin="0,0,8,0">
                                    <TextBlock Text="ACEITAR" FontFamily="Segoe UI" FontWeight="Black" FontSize="11" Foreground="White"/>
                                </Button>
                                <Button Grid.Column="3"
                                        Command="{Binding DataContext.DeclineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        Background="Transparent" BorderThickness="1" BorderBrush="#3A2A30"
                                        Padding="14,6" Cursor="Hand">
                                    <TextBlock Text="RECUSAR" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="#EF4444"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- OUTGOING -->
            <ItemsControl Grid.Row="6" ItemsSource="{Binding Outgoing}"
                          Visibility="{Binding IsOutgoingTab, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8"
                                Background="#12151B" BorderBrush="#1E232E" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <c:LevelBadge Grid.Column="0" Level="{Binding Addressee.Level}" Size="40" ShowTier="False" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Addressee.Nickname}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Aguardando resposta…" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#FACC15" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="4" Padding="10,4" Background="#1E232E">
                                    <TextBlock Text="PENDENTE" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="10" Foreground="#FACC15"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- TEAM INVITES -->
            <ItemsControl Grid.Row="6" ItemsSource="{Binding TeamInvites}"
                          Visibility="{Binding IsTeamInvitesTab, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,14" CornerRadius="8"
                                Background="#12151B" BorderBrush="#1E232E" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Margin="0,0,14,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFB300" Offset="0"/>
                                            <GradientStop Color="#FF7A00" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Team.Tag}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="12" Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Team.Name}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#9AA5B5" Margin="0,3,0,0">
                                        <Run Text="Convidado por "/><Run Text="{Binding InvitedBy.Nickname, Mode=OneWay}" FontWeight="Bold" Foreground="#FFB300"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SmallButton}"
                                        Command="{Binding DataContext.AcceptTeamInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}" Margin="0,0,8,0">
                                    <TextBlock Text="ACEITAR" FontFamily="Segoe UI" FontWeight="Black" FontSize="11" Foreground="White"/>
                                </Button>
                                <Button Grid.Column="3"
                                        Command="{Binding DataContext.DeclineTeamInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        Background="Transparent" BorderThickness="1" BorderBrush="#3A2A30"
                                        Padding="14,6" Cursor="Hand">
                                    <TextBlock Text="RECUSAR" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="#EF4444"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
</UserControl>
