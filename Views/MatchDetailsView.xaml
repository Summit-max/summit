<UserControl x:Class="Summit.Views.MatchDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Scoreboard row template (DataContext = ScoreboardRow) -->
        <DataTemplate x:Key="ScoreboardRowTpl">
            <Border BorderBrush="#1D222C" BorderThickness="0,0,0,1" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.ViewPlayerCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding UserId}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#171B22"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="62"/>
                    </Grid.ColumnDefinitions>

                    <c:LevelBadge Grid.Column="0" Level="{Binding Level}" Size="36" ShowTier="False" Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Country}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="13" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Border CornerRadius="3" Padding="6,2" Background="#30FFD700" Margin="8,0,0,0"
                                Visibility="{Binding IsMvp, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="MVP" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="9" Foreground="#FFD700"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding Kills}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontWeight="Black" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Deaths}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="#9AA5B5"/>
                    <TextBlock Grid.Column="4" Text="{Binding Assists}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="#9AA5B5"/>
                    <TextBlock Grid.Column="5" Text="{Binding KDText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontWeight="Black" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Grid.Column="6" Text="{Binding AdrText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Grid.Column="7" Text="{Binding HSText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="#FF6A1A"/>
                    <TextBlock Grid.Column="8" Text="{Binding RatingText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontWeight="Black" FontSize="13" Foreground="#22C55E"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer>
        <Grid Margin="40,24,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Back -->
            <Button Grid.Row="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Command="{Binding BackCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#9AA5B5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="VOLTAR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="10" Foreground="#9AA5B5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HERO (scoreline) -->
            <Border Grid.Row="2" CornerRadius="14" Padding="32,24"
                    BorderBrush="#232937" BorderThickness="1" DataContext="{Binding Match}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1A0906" Offset="0"/>
                        <GradientStop Color="#12151B" Offset="0.5"/>
                        <GradientStop Color="#1A0906" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Team A -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TeamATag}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="36" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#9AA5B5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TeamAWon}" Value="True">
                                            <Setter Property="Foreground" Value="#F2F5FA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding TeamAName}" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#5A6577" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Score -->
                    <StackPanel Grid.Column="1" Margin="36,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ScoreA}" FontFamily="Segoe UI" FontWeight="Black" FontSize="64">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9AA5B5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TeamAWon}" Value="True">
                                                <Setter Property="Foreground">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF9A3C" Offset="0"/>
                                                            <GradientStop Color="#FF3B30" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text=" : " FontFamily="Segoe UI" FontWeight="Black" FontSize="44"
                                       Foreground="#434D5F" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScoreB}" FontFamily="Segoe UI" FontWeight="Black" FontSize="64">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9AA5B5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TeamBWon}" Value="True">
                                                <Setter Property="Foreground">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF9A3C" Offset="0"/>
                                                            <GradientStop Color="#FF3B30" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Border CornerRadius="3" Padding="8,3" Background="#141821"
                                    BorderBrush="#262C39" BorderThickness="1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Map}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="10" Foreground="#FF6A1A"/>
                            </Border>
                            <Border CornerRadius="3" Padding="8,3" Background="#141821"
                                    BorderBrush="#262C39" BorderThickness="1">
                                <TextBlock Text="{Binding DataContext.DurationLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#9AA5B5"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Team B -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TeamBTag}" FontFamily="Segoe UI" FontWeight="Black" FontSize="36">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#9AA5B5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TeamBWon}" Value="True">
                                            <Setter Property="Foreground" Value="#F2F5FA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding TeamBName}" FontFamily="Segoe UI" FontSize="11" Foreground="#5A6577"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SCOREBOARD -->
            <Border Grid.Row="4" CornerRadius="10" Background="#12151B"
                    BorderBrush="#1E232E" BorderThickness="1">
                <StackPanel>
                    <!-- Side A header -->
                    <Border Padding="14,12" Background="#141821" CornerRadius="10,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Match.TeamAName}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="13" Foreground="#FF6A1A" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="K"  FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="D"  FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="A"  FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="K/D" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="ADR" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="HS%" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="RATING" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding SideA}"
                                  ItemTemplate="{StaticResource ScoreboardRowTpl}"/>

                    <!-- Divider -->
                    <Rectangle Height="2" Fill="#1E232E" Margin="0,8"/>

                    <!-- Side B header -->
                    <Border Padding="14,12" Background="#141821">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Match.TeamBName}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="13" Foreground="#FF6A1A" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="K"  FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="D"  FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="A"  FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="K/D" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="ADR" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="HS%" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="RATING" FontFamily="Segoe UI" FontWeight="Black" FontSize="10" Foreground="#5A6577" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding SideB}"
                                  ItemTemplate="{StaticResource ScoreboardRowTpl}"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
