<UserControl x:Class="Summit.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <h:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer>
        <Grid Margin="40,28,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Back -->
            <Button Grid.Row="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Command="{Binding BackCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#9AA5B5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="VOLTAR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="10" Foreground="#9AA5B5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Grid.Row="2" Text="HISTÓRICO DE AUDITORIA" FontFamily="Segoe UI" FontWeight="Black"
                       FontSize="28" Foreground="{StaticResource BrushTextPrimary}"/>

            <StackPanel Grid.Row="4">
                <!-- Empty state -->
                <StackPanel Visibility="{Binding HasNone, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center" Margin="0,40,0,0">
                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               Foreground="#262C39" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Nenhum registro ainda" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#5A6577" HorizontalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="8"
                                    Background="#12151B" BorderBrush="#1E232E" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Action}" FontFamily="Segoe UI" FontWeight="Black"
                                                   FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#9AA5B5" Margin="0,3,0,0"
                                                   Visibility="{Binding NewValue, Converter={StaticResource NullOrEmptyToVisibility}}">
                                            <Run Text="{Binding OldValue, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding NewValue, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Reason}" FontFamily="Segoe UI" FontSize="11"
                                                   Foreground="#5A6577" Margin="0,3,0,0" FontStyle="Italic"
                                                   Visibility="{Binding Reason, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='dd/MM HH:mm'}"
                                               FontFamily="Segoe UI" FontSize="10" Foreground="#5A6577"
                                               VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
