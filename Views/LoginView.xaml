<Window x:Class="Summit.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:Summit.Helpers"
        Title="Summit"
        Width="960" Height="580"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Window.Resources>

    <Border CornerRadius="14" ClipToBounds="True">
        <Grid>

            <!-- Background -->
            <Rectangle Fill="{StaticResource BrushGradientBg}" RadiusX="14" RadiusY="14"/>

            <!-- Decorative brand circle glow -->
            <Ellipse Width="600" Height="600"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="-200,0,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#18FF4D00" Offset="0"/>
                        <GradientStop Color="#00FF4D00" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Geometric diagonal accent line -->
            <Line X1="0" Y1="580" X2="500" Y2="0"
                  Stroke="#10FF6A00" StrokeThickness="120"
                  HorizontalAlignment="Left" VerticalAlignment="Stretch"/>

            <!-- Title bar drag / window controls -->
            <Grid Height="40" VerticalAlignment="Top" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource TitleBarButton}" Command="{Binding MinimizeCommand}"/>
                    <Button Style="{StaticResource TitleBarButtonClose}" Command="{Binding CloseCommand}">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main two-column layout -->
            <Grid Margin="0,40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT — Branding -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="64,0,40,0">

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="▲" FontSize="44" VerticalAlignment="Center" Margin="0,0,16,4"
                                   Foreground="{StaticResource BrushAccent}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF6A00" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="SUMMIT"
                                   FontFamily="Segoe UI" FontWeight="Black" FontSize="52"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="A ARENA DOS MELHORES."
                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}"

                               Margin="22,0,0,0"/>

                    <Border Width="80" Height="2" HorizontalAlignment="Left"
                               Margin="22,24,0,32">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6A00" Offset="0"/>
                                <GradientStop Color="#00FF6A00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Feature pills -->
                    <WrapPanel Margin="22,0,0,0">
                        <Border CornerRadius="6" Padding="12,6" Margin="0,0,8,8" Background="#181D26" BorderBrush="#262C39" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF6A00" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Torneios" FontSize="12" Foreground="#9AA5B5" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="12,6" Margin="0,0,8,8" Background="#181D26" BorderBrush="#262C39" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF6A00" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Times" FontSize="12" Foreground="#9AA5B5" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="12,6" Margin="0,0,8,8" Background="#181D26" BorderBrush="#262C39" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF6A00" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Stats" FontSize="12" Foreground="#9AA5B5" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="12,6" Margin="0,0,8,8" Background="#181D26" BorderBrush="#262C39" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF6A00" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Badges" FontSize="12" Foreground="#9AA5B5" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- RIGHT — Login Panel -->
                <Border Grid.Column="1" Background="{StaticResource BrushLoginPanel}"
                        BorderBrush="#1E232E" BorderThickness="1,0,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="44,0">

                        <TextBlock Text="BEM-VINDO" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="10" Foreground="#FF6A00"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Entre na sua conta" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="26" Foreground="{StaticResource BrushTextPrimary}"
                                   Margin="0,0,0,36"/>

                        <!-- Steam button -->
                        <Button Command="{Binding LoginWithSteamCommand}"
                                Style="{StaticResource SteamLoginButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7C5;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="White"/>
                                <TextBlock Text="ENTRAR COM STEAM" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="14" VerticalAlignment="Center"
                                           Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <!-- Divider -->
                        <Grid Margin="0,20,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#1E232E" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ou" Foreground="#434D5F" FontSize="12"
                                       FontFamily="Segoe UI" Margin="12,0"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#1E232E" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Demo button -->
                        <Button Content="ENTRAR EM MODO DEMO"
                                Command="{Binding LoginDemoCommand}"
                                Style="{StaticResource SecondaryButton}"/>

                        <!-- Loading bar -->
                        <Grid Margin="0,20,0,0"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar IsIndeterminate="True" Height="2"
                                         Background="Transparent"
                                         Foreground="{StaticResource BrushGradientBrand}"/>
                            <TextBlock Text="Autenticando..." HorizontalAlignment="Center"
                                       Foreground="#9AA5B5" FontSize="12" FontFamily="Segoe UI"
                                       Margin="0,8,0,0"/>
                        </Grid>

                        <!-- Error -->
                        <Border Margin="0,16,0,0" CornerRadius="6" Background="#2A1212"
                                BorderBrush="#60EF4444" BorderThickness="1" Padding="12,10"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444"
                                       FontSize="12" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Footer -->
                        <TextBlock Text="Ao entrar, você concorda com os Termos de Uso da Summit."
                                   FontFamily="Segoe UI" FontSize="10" Foreground="#434D5F"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,28,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
