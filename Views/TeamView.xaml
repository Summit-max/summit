<UserControl x:Class="Summit.Views.TeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
        <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <Grid Margin="32,28,32,32">
        <!-- Has Team -->
        <Grid Visibility="{Binding HasTeam, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Team header -->
            <Border Grid.Row="0" CornerRadius="12" Padding="28,22"
                    Background="#141821" BorderBrush="#262C39" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.35" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Team logo placeholder -->
                    <Border Width="64" Height="64" CornerRadius="8" Margin="0,0,20,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6A1A" Offset="0"/>
                                <GradientStop Color="#FF3B30" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding Team.Tag}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="16" Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Team.Name}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="26" Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#9AA5B5" Margin="0,4,0,0">
                            <Run Text="["/><Run Text="{Binding Team.Tag, Mode=OneWay}" FontWeight="Bold" Foreground="#FF6A1A"/><Run Text="]  •  "/>
                            <Run Text="{Binding Team.Members.Count, Mode=OneWay}"/><Run Text=" jogadores"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Team stats -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="6" Background="#1E232E" Padding="16,10" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TORNEIOS" FontFamily="Segoe UI" FontWeight="Bold"
                                           FontSize="8" Foreground="#9AA5B5" Margin="0,0,0,4"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Team.TournamentsPlayed}" FontFamily="Segoe UI"
                                           FontWeight="Black" FontSize="22"
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Background="#1E232E" Padding="16,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="WINRATE" FontFamily="Segoe UI" FontWeight="Bold"
                                           FontSize="8" Foreground="#9AA5B5" Margin="0,0,0,4"
                                           HorizontalAlignment="Center"/>
                                <TextBlock FontFamily="Segoe UI" FontWeight="Black" FontSize="22"
                                           Foreground="#22C55E" HorizontalAlignment="Center">
                                    <Run Text="{Binding Team.WinRate, StringFormat=P0, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Section heading -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="3" Height="20" CornerRadius="2" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF6A1A" Offset="0"/>
                                <GradientStop Color="#FF3B30" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="LINEUP" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenAuditLogCommand}" Background="Transparent"
                            BorderThickness="1" BorderBrush="#262C39" Padding="14,6" Cursor="Hand"
                            Margin="0,0,8,0">
                        <TextBlock Text="HISTÓRICO" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="11" Foreground="#9AA5B5"/>
                    </Button>
                    <Button Command="{Binding OpenJoinRequestsCommand}" Background="Transparent"
                            BorderThickness="1" BorderBrush="#262C39" Padding="14,6" Cursor="Hand"
                            Visibility="{Binding IsMyTeamCaptain, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,8,0">
                        <TextBlock Text="SOLICITAÇÕES" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="11" Foreground="#9AA5B5"/>
                    </Button>
                    <Button Command="{Binding OpenEditTeamCommand}" Background="Transparent"
                            BorderThickness="1" BorderBrush="#262C39" Padding="14,6" Cursor="Hand"
                            Visibility="{Binding IsMyTeamCaptain, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,8,0">
                        <TextBlock Text="EDITAR TIME" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="11" Foreground="#9AA5B5"/>
                    </Button>
                    <Button Style="{StaticResource SmallButton}"
                            Command="{Binding OpenInviteCommand}"
                            Visibility="{Binding CanInvite, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="CONVIDAR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="11" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LeaveTeamCommand}" Background="Transparent"
                            BorderThickness="1" BorderBrush="#3A2A30" Padding="14,6" Cursor="Hand"
                            Margin="0,0,8,0">
                        <TextBlock Text="SAIR DO TIME" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="11" Foreground="#EF4444"/>
                    </Button>
                    <Button Command="{Binding DeleteTeamCommand}" Background="Transparent"
                            BorderThickness="1" BorderBrush="#3A2A30" Padding="14,6" Cursor="Hand"
                            Visibility="{Binding IsMyTeamCaptain, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="EXCLUIR TIME" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="11" Foreground="#EF4444"/>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4">

            <!-- Delete confirm -->
            <Border Visibility="{Binding ConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="8" Padding="18,14" Margin="0,0,0,14"
                    Background="#1F1416" BorderBrush="#50EF4444" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="EXCLUIR O TIME? ESSA AÇÃO NÃO PODE SER DESFEITA." FontFamily="Segoe UI"
                               FontWeight="Black" FontSize="11" Foreground="#EF4444" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding DeleteErrorMessage}" FontFamily="Segoe UI" TextWrapping="Wrap"
                               FontSize="11" Foreground="#EF4444" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ConfirmDeleteTeamCommand}" Background="#EF4444"
                                BorderThickness="0" Padding="16,7" Cursor="Hand" Margin="0,0,8,0">
                            <TextBlock Text="SIM, EXCLUIR" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="11" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding CancelDeleteTeamCommand}" Background="Transparent"
                                BorderThickness="0" Padding="10,0" Cursor="Hand">
                            <TextBlock Text="CANCELAR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="11" Foreground="#9AA5B5"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Edit team panel -->
            <Border Visibility="{Binding IsEditingTeam, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="8" Padding="18,14" Margin="0,0,0,14"
                    Background="#151A23" BorderBrush="#50FF6A1A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="EDITAR TIME" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="10" Foreground="#FF6A1A" Margin="0,0,0,10"/>
                    <TextBlock Text="NOME" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9"
                               Foreground="#9AA5B5" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                             Text="{Binding EditTeamName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="DESCRIÇÃO" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9"
                               Foreground="#9AA5B5" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                             Text="{Binding EditTeamDescription, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="PAÍS" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9"
                               Foreground="#9AA5B5" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                             Text="{Binding EditTeamCountry, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="URL DO ESCUDO" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9"
                               Foreground="#9AA5B5" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"
                             Text="{Binding EditTeamLogoUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SmallButton}" Command="{Binding SaveTeamEditCommand}" Margin="0,0,8,0">
                            <TextBlock Text="SALVAR" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding CancelTeamEditCommand}" Background="Transparent"
                                BorderThickness="0" Padding="10,0" Cursor="Hand">
                            <TextBlock Text="CANCELAR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="11" Foreground="#9AA5B5"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Invite panel -->
            <Border Visibility="{Binding IsInviting, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="8" Padding="18,14" Margin="0,0,0,14"
                    Background="#151A23" BorderBrush="#50FF6A1A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CONVIDAR JOGADOR" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="10" Foreground="#FF6A1A" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding InviteNickname, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{StaticResource SmallButton}"
                                Command="{Binding SendInviteCommand}" Margin="10,0,6,0">
                            <TextBlock Text="ENVIAR" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding CancelInviteCommand}" Background="Transparent"
                                BorderThickness="0" Padding="10,0" Cursor="Hand">
                            <TextBlock Text="CANCELAR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="11" Foreground="#9AA5B5"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding InviteMessage}" FontFamily="Segoe UI" FontSize="11"
                               Foreground="#9AA5B5" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Members list -->
            <ItemsControl ItemsSource="{Binding Team.Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardFlat}" Margin="0,0,0,8" Cursor="Hand"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.01" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.01" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                        Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#262C39" Offset="0"/>
                                            <GradientStop Color="#1D222C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Nickname[0]}" FontFamily="Segoe UI"
                                               FontWeight="Black" FontSize="16" Foreground="#9AA5B5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name + role -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI"
                                                   FontWeight="Bold" FontSize="14"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <!-- Captain crown -->
                                        <TextBlock Text="  &#xE734;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="#FFD700" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCaptain}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PrimaryRole}" FontFamily="Segoe UI"
                                               FontSize="11" Foreground="#9AA5B5" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Rank -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="10,4"
                                        Background="#1D222C" BorderBrush="#262C39" BorderThickness="1"
                                        Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Rank}" FontFamily="Segoe UI"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAccent}"/>
                                </Border>

                                <!-- Ações de cargo (só visíveis pro capitão, nunca na própria linha dele) -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0">
                                    <Button Command="{Binding DataContext.PromoteCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Background="Transparent" BorderThickness="1" BorderBrush="#262C39"
                                            Padding="10,4" Cursor="Hand" Margin="0,0,6,0" ToolTip="Promover a sublíder">
                                        <TextBlock Text="PROMOVER" FontFamily="Segoe UI" FontWeight="Bold"
                                                   FontSize="9" Foreground="#9AA5B5"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.IsMyTeamCaptain, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                            <Condition Binding="{Binding IsCaptain}" Value="False"/>
                                                            <Condition Binding="{Binding IsViceCaptain}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding DataContext.DemoteCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Background="Transparent" BorderThickness="1" BorderBrush="#262C39"
                                            Padding="10,4" Cursor="Hand" Margin="0,0,6,0" ToolTip="Rebaixar a membro">
                                        <TextBlock Text="REBAIXAR" FontFamily="Segoe UI" FontWeight="Bold"
                                                   FontSize="9" Foreground="#9AA5B5"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.IsMyTeamCaptain, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                            <Condition Binding="{Binding IsViceCaptain}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding DataContext.TransferOwnershipCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Background="Transparent" BorderThickness="1" BorderBrush="#3A2A30"
                                            Padding="10,4" Cursor="Hand" Margin="0,0,6,0" ToolTip="Transferir propriedade do time">
                                        <TextBlock Text="TORNAR DONO" FontFamily="Segoe UI" FontWeight="Bold"
                                                   FontSize="9" Foreground="#EF4444"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.IsMyTeamCaptain, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                            <Condition Binding="{Binding IsCaptain}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding DataContext.KickCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Background="Transparent" BorderThickness="1" BorderBrush="#3A2A30"
                                            Padding="10,4" Cursor="Hand" ToolTip="Remover do time">
                                        <TextBlock Text="REMOVER" FontFamily="Segoe UI" FontWeight="Bold"
                                                   FontSize="9" Foreground="#EF4444"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.IsMyTeamCaptain, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                            <Condition Binding="{Binding IsCaptain}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <Button Grid.Column="4" Style="{StaticResource IconButton}"
                                        Command="{Binding DataContext.ViewPlayerCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        ToolTip="Ver perfil">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="#9AA5B5"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- No Team -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasNoTeam, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="64"
                       Foreground="#262C39" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Você não está em um time" FontFamily="Segoe UI"
                       FontWeight="Bold" FontSize="18" Foreground="#9AA5B5"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Crie um time para participar de torneios com amigos."
                       FontFamily="Segoe UI" FontSize="13" Foreground="#434D5F"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <!-- Create form -->
            <StackPanel Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}"
                        Width="380">
                <TextBlock Text="NOME DO TIME" FontFamily="Segoe UI" FontWeight="Bold"
                           FontSize="9" Foreground="#9AA5B5" Margin="0,0,0,6"/>
                <TextBox Text="{Binding NewTeamName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>
                <TextBlock Text="TAG (3-5 letras)" FontFamily="Segoe UI" FontWeight="Bold"
                           FontSize="9" Foreground="#9AA5B5" Margin="0,0,0,6"/>
                <TextBox Text="{Binding NewTeamTag, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}" MaxLength="5" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="CRIAR TIME" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmCreateCommand}" Margin="0,0,8,0"/>
                    <Button Content="CANCELAR" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCreateCommand}"/>
                </StackPanel>
            </StackPanel>

            <Button Content="CRIAR TIME" Style="{StaticResource PrimaryButton}"
                    Command="{Binding CreateTeamCommand}"
                    Visibility="{Binding IsCreating, Converter={StaticResource InverseBoolToVisibility}}"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
