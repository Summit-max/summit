<UserControl x:Class="Summit.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter    x:Key="BoolToVisibility"/>
        <h:BoolToWinLossConverter       x:Key="BoolToWinLoss"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="40,32,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="ESTATÍSTICAS" FontFamily="Segoe UI" FontWeight="Black"
                   FontSize="36" Foreground="{StaticResource BrushTextPrimary}"/>
        <TextBlock Grid.Row="2" Text="Seu desempenho completo no Summit."
                   FontFamily="Segoe UI" FontSize="13" Foreground="#9999AA"/>

        <!-- HERO: K/D grande no centro + WR (esq) + HS (dir) -->
        <Border Grid.Row="4" Height="280" CornerRadius="14" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A0B06" Offset="0"/>
                    <GradientStop Color="#17171A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6A0050" Offset="0"/>
                    <GradientStop Color="#22222A" Offset="0.6"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>

            <Grid>
                <Ellipse Width="700" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#20FF6A00" Offset="0"/>
                            <GradientStop Color="#00FF6A00" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid Margin="48,36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- WINRATE -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="WINRATE" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="10" Foreground="#FF6A00" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding WinRateText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="64" Foreground="{StaticResource BrushTextPrimary}"/>

                        <Grid Height="6" Margin="0,12,20,0">
                            <Border CornerRadius="3" Background="#1A1A22"/>
                            <ProgressBar Value="{Binding WinRateValue, Mode=OneWay}"
                                         Maximum="1" Minimum="0"
                                         BorderThickness="0" Background="Transparent">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border CornerRadius="3" Background="Transparent"/>
                                            <Border x:Name="PART_Track" CornerRadius="3"/>
                                            <Border x:Name="PART_Indicator" CornerRadius="3"
                                                    HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#22C55E" Offset="0"/>
                                                        <GradientStop Color="#15803D" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </Grid>
                        <TextBlock Text="Taxa de vitórias por partida" FontFamily="Segoe UI"
                                   FontSize="11" Foreground="#55555F" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- K/D (centro, destaque) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="K/D RATIO" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="11" Foreground="#FF6A00" Margin="0,0,0,14"
                                   HorizontalAlignment="Center"/>
                        <Grid>
                            <TextBlock Text="{Binding KDText}" FontFamily="Segoe UI" FontWeight="Black"
                                       FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFE66B" Offset="0"/>
                                        <GradientStop Color="#FF6A00" Offset="0.5"/>
                                        <GradientStop Color="#D7261E" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF4D00" BlurRadius="26"
                                                      ShadowDepth="0" Opacity="0.55"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                        <Grid Height="6" Margin="24,14,24,0">
                            <Border CornerRadius="3" Background="#1A1A22"/>
                            <ProgressBar Value="{Binding KDNormalized, Mode=OneWay}"
                                         Maximum="1" Minimum="0"
                                         BorderThickness="0" Background="Transparent">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border CornerRadius="3" Background="Transparent"/>
                                            <Border x:Name="PART_Track" CornerRadius="3"/>
                                            <Border x:Name="PART_Indicator" CornerRadius="3"
                                                    HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF6A00" Offset="0"/>
                                                        <GradientStop Color="#D7261E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </Grid>
                        <TextBlock Text="Razão entre kills e deaths" FontFamily="Segoe UI"
                                   FontSize="11" Foreground="#55555F"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- HEADSHOT % -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="HEADSHOT %" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="10" Foreground="#FF6A00" Margin="0,0,0,10"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding HSText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="64" Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Right"/>

                        <Grid Height="6" Margin="20,12,0,0" Width="180" HorizontalAlignment="Right">
                            <Border CornerRadius="3" Background="#1A1A22"/>
                            <ProgressBar Value="{Binding HSValue, Mode=OneWay}"
                                         Maximum="1" Minimum="0"
                                         BorderThickness="0" Background="Transparent">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border CornerRadius="3" Background="Transparent"/>
                                            <Border x:Name="PART_Track" CornerRadius="3"/>
                                            <Border x:Name="PART_Indicator" CornerRadius="3"
                                                    HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#38BDF8" Offset="0"/>
                                                        <GradientStop Color="#1E70B8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </Grid>
                        <TextBlock Text="Abates com headshot" FontFamily="Segoe UI"
                                   FontSize="11" Foreground="#55555F"
                                   HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- SECONDARY STATS STRIP -->
        <Border Grid.Row="6" CornerRadius="10" Background="#13131A"
                BorderBrush="#22222A" BorderThickness="1">
            <Grid Height="96">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="ADR" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="9" Foreground="#55555F" HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ADRText}" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="24" Foreground="{StaticResource BrushTextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="dano/round" FontFamily="Segoe UI" FontSize="10"
                               Foreground="#44444E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="#22222A"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="PARTIDAS" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="9" Foreground="#55555F" HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding TotalMatches}" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="24" Foreground="{StaticResource BrushTextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="jogadas" FontFamily="Segoe UI" FontSize="10"
                               Foreground="#44444E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <Rectangle Grid.Column="3" Fill="#22222A"/>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="VITÓRIAS" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="9" Foreground="#55555F" HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding TotalWins}" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="24" Foreground="#22C55E"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="ganhas" FontFamily="Segoe UI" FontSize="10"
                               Foreground="#44444E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <Rectangle Grid.Column="5" Fill="#22222A"/>

                <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="DERROTAS" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="9" Foreground="#55555F" HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding TotalLosses}" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="24" Foreground="#EF4444"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="perdidas" FontFamily="Segoe UI" FontSize="10"
                               Foreground="#44444E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <Rectangle Grid.Column="7" Fill="#22222A"/>

                <StackPanel Grid.Column="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="K / D / A" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="9" Foreground="#55555F" HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Segoe UI" FontWeight="Black" FontSize="18"
                               HorizontalAlignment="Center">
                        <Run Text="{Binding TotalKills, Mode=OneWay}" Foreground="#F5F5F5"/>
                        <Run Text=" / " Foreground="#44444E"/>
                        <Run Text="{Binding TotalDeaths, Mode=OneWay}" Foreground="#9999AA"/>
                        <Run Text=" / " Foreground="#44444E"/>
                        <Run Text="{Binding TotalAssists, Mode=OneWay}" Foreground="#9999AA"/>
                    </TextBlock>
                    <TextBlock Text="kills · deaths · assists" FontFamily="Segoe UI" FontSize="10"
                               Foreground="#44444E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FAVORITES: map + weapon -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Height="118" CornerRadius="10"
                    Background="#13131A" BorderBrush="#22222A" BorderThickness="1" Padding="22,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="MAPA FAVORITO" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="10" Foreground="#FF6A00"/>
                        <TextBlock Text="{Binding FavoriteMap}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="32" Foreground="{StaticResource BrushTextPrimary}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="Mapa com mais partidas jogadas" FontFamily="Segoe UI"
                                   FontSize="11" Foreground="#55555F" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="&#xE707;" FontFamily="Segoe MDL2 Assets"
                               FontSize="64" Foreground="#10FF6A00" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Height="118" CornerRadius="10"
                    Background="#13131A" BorderBrush="#22222A" BorderThickness="1" Padding="22,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ARMA FAVORITA" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="10" Foreground="#FF6A00"/>
                        <TextBlock Text="{Binding FavoriteWeapon}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="32" Foreground="{StaticResource BrushTextPrimary}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="Arma com mais abates" FontFamily="Segoe UI"
                                   FontSize="11" Foreground="#55555F" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets"
                               FontSize="58" Foreground="#10FF6A00" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Section header -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,0,0,0">
            <Border Width="3" Height="18" CornerRadius="2" Margin="0,0,12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF6A00" Offset="0"/>
                        <GradientStop Color="#D7261E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock Text="DESEMPENHO RECENTE" FontFamily="Segoe UI" FontWeight="Black"
                       FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Performance list: está numa row separada abaixo via separate items control -->
        <Border Grid.Row="10" Margin="0,36,0,0" CornerRadius="8" Background="#13131A"
                BorderBrush="#22222A" BorderThickness="1">
            <ItemsControl ItemsSource="{Binding Stats.RecentPerformance}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#1C1C24" BorderThickness="0,0,0,1">
                            <Grid Height="56" Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="4" Height="28" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EF4444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Won}" Value="True">
                                                    <Setter Property="Background" Value="#22C55E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Won, Converter={StaticResource BoolToWinLoss}}"
                                           FontFamily="Segoe UI" FontWeight="Black" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Won}" Value="True">
                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="3" Text="{Binding Map}"
                                           FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                           Foreground="#CCCCD4" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="4" Text="{Binding Score}"
                                           FontFamily="Segoe UI" FontWeight="Black" FontSize="16"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="K" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="9" Foreground="#55555F"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Kills}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="D" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="9" Foreground="#55555F"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Deaths}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="13" Foreground="#9999AA"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="A" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="9" Foreground="#55555F"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Assists}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="13" Foreground="#9999AA"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="K/D" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="9" Foreground="#55555F"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding KD}" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="13" Foreground="#FF6A00"
                                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

    </Grid>
    </ScrollViewer>
</UserControl>
