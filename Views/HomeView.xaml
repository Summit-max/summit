<UserControl x:Class="Summit.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Summit.Helpers"
             xmlns:c="clr-namespace:Summit.Components"
             Background="Transparent" Opacity="0">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <h:BoolToWinLossConverter    x:Key="BoolToWinLoss"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HERO ═══ -->
        <Border Grid.Row="0" CornerRadius="10" Padding="32,24" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/hero-banner.png" Stretch="UniformToFill"
                            AlignmentX="Left" AlignmentY="Top"/>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Grid Grid.Column="0" Width="88" Height="88" Margin="0,0,24,0" VerticalAlignment="Center">
                    <Border CornerRadius="44" Background="{StaticResource BrushGradientBrandD}"
                            BorderBrush="#33FF6A1A" BorderThickness="2">
                        <TextBlock Text="{Binding WelcomeText[0]}" FontFamily="Segoe UI"
                                   FontWeight="Black" FontSize="30" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <!-- Identidade + nível -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="BEM-VINDO DE VOLTA," FontFamily="Segoe UI" FontWeight="Bold"
                               FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                        <TextBlock Text="{Binding WelcomeText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="30" Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"
                                   Margin="10,6,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="4" Padding="8,3" Background="#2A140F">
                            <TextBlock Text="{Binding UserRank}" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                        </Border>
                        <TextBlock FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="•  Steam ID: "/>
                            <Run Text="{Binding SteamId, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock FontFamily="Segoe UI" FontWeight="Bold" FontSize="9"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,20,0,7">
                        <Run Text="NÍVEL"/>
                        <Run Text="{Binding UserLevel, Mode=OneWay}"/>
                    </TextBlock>
                    <Border Height="6" CornerRadius="3" Background="#2A2E36" MaxWidth="480" HorizontalAlignment="Left">
                        <Border CornerRadius="3" Width="34" HorizontalAlignment="Left"
                                Background="{StaticResource BrushGradientBrand}"/>
                    </Border>
                </StackPanel>

                <!-- Direita: badge + CTA + próximo desafio -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Grid HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <c:LevelBadge Grid.Column="0" Level="{Binding UserLevel}" Size="64"
                                      ShowTier="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Grid.Column="1" Height="52" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenTournamentsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="VER CAMPEONATOS" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Margin="0,14,0,0" CornerRadius="6" Padding="14,10"
                            Background="#131313" BorderBrush="#2A1E18" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PRÓXIMO DESAFIO" FontFamily="Segoe UI" FontWeight="Bold"
                                           FontSize="8" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="Sistema de missões" FontFamily="Segoe UI" FontWeight="SemiBold"
                                           FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="EM BREVE" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="9" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ STATS ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="6" Background="#241411" BorderBrush="#4A2418" BorderThickness="1">
                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WINRATE" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding WinRateText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="21" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="6" Background="#241411" BorderBrush="#4A2418" BorderThickness="1">
                        <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="K/D" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding KDText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="21" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="6" Background="#241411" BorderBrush="#4A2418" BorderThickness="1">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HS%" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding HSText}" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="21" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource Card}">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="6" Background="#241411" BorderBrush="#4A2418" BorderThickness="1">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TEMPO DE JOGO" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="—" FontFamily="Segoe UI" FontWeight="Black"
                                   FontSize="21" Foreground="{StaticResource BrushTextPrimary}"
                                   ToolTip="Sem rastreamento de tempo de jogo ainda"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ DASHBOARD (3 colunas) ═══ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <!-- Campeonatos em destaque -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CAMPEONATOS EM DESTAQUE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Column="1" Text="VER TODOS" FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="10" Foreground="{StaticResource BrushAccent}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenTournamentsCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Grid>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding FeaturedTournaments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,0" CornerRadius="8" Padding="14" Cursor="Hand"
                                        Background="#131313" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                        MinHeight="190">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenTournamentCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding Id}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <Border CornerRadius="4" Padding="7,3" HorizontalAlignment="Left" Background="#152014">
                                            <TextBlock Text="{Binding StatusLabel}" FontFamily="Segoe UI" FontWeight="Bold"
                                                       FontSize="8" Foreground="{StaticResource BrushAccent}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontWeight="Black"
                                                   FontSize="14" Foreground="{StaticResource BrushTextPrimary}"
                                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                                        <TextBlock Text="INÍCIO EM" Style="{StaticResource MutedText}" Margin="0,14,0,3"/>
                                        <TextBlock Text="{Binding CountdownLabel}" FontFamily="Segoe UI" FontWeight="Bold"
                                                   FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="PRÊMIO" Style="{StaticResource MutedText}" Margin="0,10,0,3"/>
                                        <TextBlock Text="{Binding Prize}" FontFamily="Segoe UI" FontWeight="Black"
                                                   FontSize="15" Foreground="{StaticResource BrushAccent}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Partidas recentes -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="PARTIDAS RECENTES" Style="{StaticResource SectionTitle}"/>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding RecentMatches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#1D1D1D" BorderThickness="0,0,0,1" Padding="0,10" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenMatchCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding Id}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2A1414"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Won}" Value="True">
                                                            <Setter Property="Background" Value="#12281A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Map}" FontFamily="Segoe UI" FontWeight="SemiBold"
                                                       FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="5v5 • Competitivo" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Score}" FontFamily="Segoe UI" FontWeight="Black"
                                                       FontSize="13" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Won}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Won, Converter={StaticResource BoolToWinLoss}}"
                                                       FontFamily="Segoe UI" FontSize="9" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Won}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="4" Style="{StaticResource SecondaryButton}" Height="38"
                            Command="{Binding OpenMatchesCommand}">
                        <TextBlock Text="VER TODAS AS PARTIDAS" FontFamily="Segoe UI" FontWeight="Black" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Seu time + ranking da semana -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenTeamCommand}"/>
                    </Border.InputBindings>
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="SEU TIME" Style="{StaticResource SectionTitle}"/>
                        <Grid Grid.Row="2" Visibility="{Binding HasTeam, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="6" Background="{StaticResource BrushGradientBrandD}">
                                <TextBlock Text="{Binding TeamName[0]}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TeamName}" FontFamily="Segoe UI" FontWeight="Black"
                                           FontSize="13" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSuccess}" Margin="0,0,5,0"/>
                                    <TextBlock FontFamily="Segoe UI" FontSize="9" Foreground="{StaticResource BrushTextMuted}">
                                        <Run Text="{Binding TeamMemberCount, Mode=OneWay}"/>
                                        <Run Text="membros"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="RANKING DA SEMANA" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding TopPlayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#1D1D1D" BorderThickness="0,0,0,1" Padding="0,9" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenPlayerCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding UserId}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Position}" FontFamily="Segoe UI"
                                                       FontWeight="Black" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                                       VerticalAlignment="Center"/>
                                            <Ellipse Grid.Column="1" Width="26" Height="26" StrokeThickness="2" Margin="0,0,10,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Stroke" Value="{StaticResource BrushBorderSubtle}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Position}" Value="1">
                                                                <Setter Property="Stroke" Value="#E7B600"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Position}" Value="2">
                                                                <Setter Property="Stroke" Value="#9AA5B5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Position}" Value="3">
                                                                <Setter Property="Stroke" Value="#B97944"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nickname}" FontFamily="Segoe UI" FontWeight="Bold"
                                                           FontSize="11" Foreground="{StaticResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TeamTag}" Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Elo}" FontFamily="Segoe UI"
                                                       FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushAccent}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Row="4" Style="{StaticResource SecondaryButton}" Height="38"
                                Command="{Binding OpenRankingCommand}">
                            <TextBlock Text="VER RANKING COMPLETO" FontFamily="Segoe UI" FontWeight="Black" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ BANNER DE TEMPORADA (placeholder — sem sistema de temporada no backend) ═══ -->
        <Border Grid.Row="6" CornerRadius="10" Padding="24,18" ClipToBounds="True">
            <Grid>
                <Image Source="/Assets/season-banner.png" Stretch="UniformToFill"/>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#C0100A08" Offset="0"/>
                            <GradientStop Color="#A0111217" Offset="0.65"/>
                            <GradientStop Color="#60111217" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/Assets/logo.png" Height="34" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="TEMPORADA 9 — RELOADED" FontFamily="Segoe UI" FontWeight="Black"
                               FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="A nova temporada está no ar. Suba no ranking e conquiste recompensas exclusivas."
                               FontFamily="Segoe UI" FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="38" Padding="20,0">
                    <TextBlock Text="CONFERIR NOVIDADES" FontFamily="Segoe UI" FontWeight="Black" FontSize="10"/>
                </Button>
                </Grid>
            </Grid>
        </Border>

    </Grid>
    </ScrollViewer>
</UserControl>
