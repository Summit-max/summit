<UserControl x:Class="Summit.Components.LevelBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Viewbox Stretch="Uniform"
             Width="{Binding Size, ElementName=Root}"
             Height="{Binding Size, ElementName=Root}">

        <StackPanel Background="Transparent">

            <!-- Circular badge -->
            <Grid Width="72" Height="72" HorizontalAlignment="Center">

                <!-- Tier ring -->
                <Ellipse x:Name="Ring" StrokeThickness="3">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E232E" Offset="0"/>
                            <GradientStop Color="#0E1117" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Inner plate separator -->
                <Ellipse Margin="7" Stroke="#262C39" StrokeThickness="1"/>

                <!-- Level number -->
                <TextBlock x:Name="LevelText"
                           FontFamily="Segoe UI"
                           FontWeight="Black"
                           FontSize="26"
                           Foreground="#F2F5FA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"/>
            </Grid>

            <!-- Tier chip (below) -->
            <Border x:Name="TierStrip"
                    HorizontalAlignment="Center"
                    Margin="0,7,0,0"
                    CornerRadius="8"
                    Padding="9,3"
                    BorderThickness="1">
                <TextBlock x:Name="TierText"
                           FontFamily="Segoe UI"
                           FontWeight="Black"
                           FontSize="8"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </Border>
        </StackPanel>
    </Viewbox>
</UserControl>
